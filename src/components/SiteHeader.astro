---
import { categorySlug, site } from '../data/site';
import { productCategories } from '../data/product-categories';
import GoogleAnalytics from './GoogleAnalytics.astro';
---
<GoogleAnalytics />
<header class="app-header">
  <div class="header-inner">
    <div class="header-left">
      <button class="header-tool category-trigger" type="button" aria-expanded="false"><span class="tool-icon">☷</span><span>Category</span></button>
      <button class="header-tool search-trigger" type="button" aria-expanded="false"><span class="tool-icon">⌕</span><span>Search</span></button>
    </div>
    <a class="brand-lockup" href="/"><span class="brand-mark">{site.name.slice(0,1)}</span><span>{site.name}</span></a>
    <div class="header-right">
      <button class="icon-link" type="button" data-inquiry-product data-inquiry-channel="whatsapp" aria-label="WhatsApp" title="WhatsApp">◉</button>
      <button class="icon-link" type="button" data-inquiry-product data-inquiry-channel="email" aria-label="Email" title="Email">✉</button>
      <button class="icon-link contact-trigger contact-icon" type="button" aria-label="Contact" title="Contact"><img src="/contact.svg" alt="" /></button>
    </div>
  </div>
  <div class="search-panel" id="global-search-panel" hidden>
    <div class="search-wrap"><span class="search-icon">⌕</span><input class="search global-search" type="search" placeholder="Search collection" aria-label="Search collection" autocomplete="off" /></div>
    <div class="search-results" role="listbox" hidden></div>
  </div>
  <div class="category-panel" id="global-category-panel" hidden>
    <nav class="category-list" aria-label="Categories">
      <a class="category-option" data-category="All" href="/?category=all">All products</a>
      {productCategories.map((category) => <a class="category-option" data-category={category} href={'/?category=' + categorySlug(category)}>{category}</a>)}
      <button class="category-option category-parent" type="button" data-filter-mode="tags" aria-expanded="false">Tags<span aria-hidden="true">›</span></button>
      <button class="category-option category-parent" type="button" data-filter-mode="brands" aria-expanded="false">Brands<span aria-hidden="true">›</span></button>
    </nav>
    <section class="category-submenu" data-submenu="tags" aria-label="Tags" hidden><div class="category-submenu-heading">Tags</div><div class="category-terms" data-terms="tags"><span class="category-terms-loading">Loading…</span></div></section>
    <section class="category-submenu" data-submenu="brands" aria-label="Brands" hidden><div class="category-submenu-heading">Brands</div><div class="category-terms" data-terms="brands"><span class="category-terms-loading">Loading…</span></div></section>
  </div>
</header>
<script src="/search.js" defer></script>
<script src="/category-menu.js" defer></script>
<script src="/contact-modal.js" defer></script>

