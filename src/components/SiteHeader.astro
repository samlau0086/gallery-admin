---
import { site } from '../data/site';
---
<header class="app-header"><div class="header-inner"><div class="header-left"><button class="header-tool category-trigger" type="button" aria-expanded="false"><span class="tool-icon">☷</span><span>Category</span></button><button class="header-tool search-trigger" type="button" aria-expanded="false"><span class="tool-icon">⌕</span><span>Search</span></button></div><a class="brand-lockup" href="/"><span class="brand-mark">{site.name.slice(0,1)}</span><span>{site.name}</span></a><div class="header-right"><a class="icon-link" href={site.contact.whatsapp} aria-label="WhatsApp" title="WhatsApp">◉</a><a class="icon-link" href={site.contact.email} aria-label="Email" title="Email">✉</a><button class="icon-link contact-trigger contact-icon" type="button" aria-label="Contact" title="Contact"><img src="/contact.svg" alt="" /></button></div></div></header><div class="search-panel" id="global-search-panel" hidden><div class="search-wrap"><span class="search-icon">⌕</span><input class="search global-search" type="search" placeholder="Search collection" aria-label="Search collection" autocomplete="off" /></div><div class="search-results" role="listbox" hidden></div></div>
<script is:inline>(() => { const trigger=document.currentScript?.previousElementSibling?.previousElementSibling?.querySelector('.search-trigger') || document.querySelector('.search-trigger'); const panel=document.querySelector('#global-search-panel'); const input=panel?.querySelector('.global-search'); const results=panel?.querySelector('.search-results'); if(!trigger||!panel||!input||!results)return; trigger.addEventListener('click',()=>{panel.hidden=!panel.hidden; if(!panel.hidden)input.focus(); trigger.setAttribute('aria-expanded',String(!panel.hidden))}); input.addEventListener('input',()=>{const q=input.value.trim(); if(!q){results.hidden=true;return} fetch('/api/search?q='+encodeURIComponent(q)).then(r=>r.json()).then(data=>{results.innerHTML=(data.results||[]).map(item=>'<a class="search-result" href="/products/'+item.slug+'/" role="option"><img src="'+item.cover+'" alt=""><span><strong>'+ (item.titleZh||item.title) +'</strong><em>'+item.category+' · '+item.title+'</em></span></a>').join('')||'<div class="search-empty">No matching works</div>';results.hidden=false}).catch(()=>{results.hidden=true})}); input.addEventListener('keydown',event=>{if(event.key==='Enter'&&input.value.trim()){event.preventDefault();location.href='/search?q='+encodeURIComponent(input.value.trim())}}); })();</script>
