---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { site } from '../../data/site';
import '../../styles/global.css';
import '../../styles/overrides.css';
export const prerender = true;
export async function getStaticPaths(){const products=await getCollection('products',({data})=>data.published);return products.map(product=>({params:{slug:product.slug},props:{product}}));}
const {product}=Astro.props;const {Content}=await render(product);const media=product.data.media.length?product.data.media:[{url:product.data.cover,type:'image',alt:product.data.title}];const reviews=product.data.reviews??[];const average=reviews.length?reviews.reduce((sum,r)=>sum+r.rating,0)/reviews.length:0;const message=`I'm interested in this ${product.data.title}, please send me a quote`;const whatsappHref=`${site.contact.whatsapp}?text=${encodeURIComponent(message)}`;const emailHref=`${site.contact.email}?subject=${encodeURIComponent(`Quote request: ${product.data.title}`)}&body=${encodeURIComponent(message)}`;
---
<Layout title={product.data.title+' · '+site.name} description={product.data.description}><div class="app-shell"><header class="app-header"><div class="header-inner"><a class="brand-lockup" href="/"><span class="brand-mark">{site.name.slice(0,1)}</span><span>{site.name}</span></a><div class="header-right"><a class="icon-link" href={whatsappHref}>WhatsApp</a><a class="icon-link" href={emailHref}>Email</a></div></div></header><main class="shell detail"><a class="back" href="/">← Back to collection</a><div class="detail-grid"><div class="media-stack"><div class="media-hero" id="media-hero">{media[0].type==='video'?<video src={media[0].url} controls />:<img src={media[0].url} alt={media[0].alt??product.data.title}/>}</div><div class="media-thumbs">{media.map((item,index)=><button class={`media-thumb ${index===0?'active':''}`} data-url={item.url} data-type={item.type} data-alt={item.alt??product.data.title} type="button">{item.type==='video'?<span>▶</span>:<img src={item.url} alt=""/>}</button>)}</div></div><aside class="detail-copy"><p class="muted">{product.data.category}</p><h1>{product.data.title}</h1>{reviews.length>0&&<div class="rating-summary"><span class="stars">{'★'.repeat(Math.round(average))}{'☆'.repeat(5-Math.round(average))}</span><a href="#reviews">{average.toFixed(1)} · {reviews.length} Reviews</a></div>}{product.data.price&&<p class="product-price">{product.data.price}</p>}<p class="product-description">{product.data.description}</p>{product.data.sku&&<p class="sku">SKU · {product.data.sku}</p>}{product.data.variants.map(variant=><fieldset class="variant-group"><legend>{variant.name}</legend><div>{variant.options.map((option,i)=><button class={`variant-option ${i===0?'selected':''}`} aria-pressed={i===0} type="button">{option}</button>)}</div></fieldset>)}<div class="contact-links"><a class="contact-link" href={whatsappHref}>WhatsApp enquiry</a><a class="contact-link" href={emailHref}>Email enquiry</a></div><div class="muted detail-body"><Content/></div></aside></div><section class="reviews-section" id="reviews"><div class="reviews-heading"><h2>Reviews</h2>{reviews.length>0&&<span>{average.toFixed(1)} / 5 · {reviews.length} reviews</span>}</div>{reviews.length>0?<div class="reviews-list">{reviews.map(review=><article class="review"><div class="review-top"><strong>{review.author}</strong><span class="stars">{'★'.repeat(review.rating)}{'☆'.repeat(5-review.rating)}</span><small>{review.date}</small></div>{review.title&&<h3>{review.title}</h3>}<p>{review.body}</p></article>)}</div>:<p class="empty-reviews">No reviews yet.</p>}</section></main></div><script>document.querySelectorAll('.variant-option').forEach(button=>button.addEventListener('click',()=>{const group=button.closest('.variant-group');group?.querySelectorAll('.variant-option').forEach(item=>{item.classList.remove('selected');item.setAttribute('aria-pressed','false')});button.classList.add('selected');button.setAttribute('aria-pressed','true')}));document.querySelectorAll('.media-thumb').forEach(button=>button.addEventListener('click',()=>{const hero=document.querySelector('#media-hero');if(!hero)return;hero.innerHTML=button.dataset.type==='video'?`<video src="${button.dataset.url}" controls></video>`:`<img src="${button.dataset.url}" alt="${button.dataset.alt||''}"/>`;document.querySelectorAll('.media-thumb').forEach(item=>item.classList.remove('active'));button.classList.add('active')}));</script></Layout>
