---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { site } from '../../data/site';
import '../../styles/global.css';
import '../../styles/overrides.css';
export const prerender = true;
export async function getStaticPaths(){const products=await getCollection('products',({data})=>data.published);return products.map(product=>({params:{slug:product.slug},props:{product}}));}
const {product}=Astro.props;const {Content}=await render(product);const media=product.data.media.length?product.data.media:[{url:product.data.cover,type:'image',alt:product.data.title}];const reviews=product.data.reviews??[];const average=reviews.length?reviews.reduce((sum,r)=>sum+r.rating,0)/reviews.length:0;const message=`I'm interested in this ${product.data.title}, please send me a quote`;const whatsappHref=`${site.contact.whatsapp}?text=${encodeURIComponent(message)}`;const emailHref=`${site.contact.email}?subject=${encodeURIComponent(`Quote request: ${product.data.title}`)}&body=${encodeURIComponent(message)}`;
---
<Layout title={product.data.title+' · '+site.name} description={product.data.description}><div class="app-shell"><header class="app-header"><div class="header-inner"><a class="brand-lockup" href="/"><span class="brand-mark">{site.name.slice(0,1)}</span><span>{site.name}</span></a><div class="header-right"><a class="icon-link inquiry-link whatsapp-inquiry" href={whatsappHref}>WhatsApp</a><a class="icon-link inquiry-link email-inquiry" href={emailHref}>Email</a></div></div></header><main class="shell detail"><a class="back" href="/">← Back to collection</a><div class="detail-grid"><div class="media-stack"><div class="media-hero" id="media-hero">{media[0].type==='video'?<video src={media[0].url} controls />:<img src={media[0].url} alt={media[0].alt??product.data.title}/>}</div><div class="media-thumbs">{media.map((item,index)=><button class={`media-thumb ${index===0?'active':''}`} data-url={item.url} data-type={item.type} data-alt={item.alt??product.data.title} type="button">{item.type==='video'?<span>▶</span>:<img src={item.url} alt=""/>}</button>)}</div></div><aside class="detail-copy"><p class="muted">{product.data.category}</p><h1>{product.data.title}</h1>{reviews.length>0&&<div class="rating-summary"><span class="stars">{'★'.repeat(Math.round(average))}{'☆'.repeat(5-Math.round(average))}</span><a href="#reviews">{average.toFixed(1)} · {reviews.length} Reviews</a></div>}{product.data.price&&<p class="product-price">{product.data.price}</p>}<p class="product-description">{product.data.description}</p>{product.data.sku&&<p class="sku">SKU · {product.data.sku}</p>}{product.data.variants.map(variant=><fieldset class="variant-group" data-variant-name={variant.name}><legend>{variant.name}</legend><div>{variant.options.map((option,i)=><button class={`variant-option ${i===0?'selected':''}`} aria-pressed={i===0} data-value={option} type="button">{option}</button>)}</div></fieldset>)}<div class="contact-links"><a class="contact-link inquiry-link whatsapp-inquiry" href={whatsappHref}>WhatsApp enquiry</a><a class="contact-link inquiry-link email-inquiry" href={emailHref}>Email enquiry</a></div><div class="muted detail-body"><Content/></div></aside></div><section class="reviews-section" id="reviews"><div class="reviews-heading"><h2>Reviews</h2>{reviews.length>0&&<span>{average.toFixed(1)} / 5 · {reviews.length} reviews</span>}</div>{reviews.length>0?<div class="reviews-list">{reviews.map(review=><article class="review"><div class="review-top"><strong>{review.author}</strong><span class="stars">{'★'.repeat(review.rating)}{'☆'.repeat(5-review.rating)}</span><small>{review.date}</small></div>{review.title&&<h3>{review.title}</h3>}<p>{review.body}</p></article>)}</div>:<p class="empty-reviews">No reviews yet.</p>}<form class="review-form" id="review-form"><h3>Write a review</h3><div class="review-form-grid"><label>Name<input name="name" required maxlength="100" /></label><label>Email<input name="email" type="email" required maxlength="200" /></label></div><label>Rating<select name="rating" required><option value="5">5 stars</option><option value="4">4 stars</option><option value="3">3 stars</option><option value="2">2 stars</option><option value="1">1 star</option></select></label><label>Title<input name="title" maxlength="160" /></label><label>Review<textarea name="body" required minlength="10" maxlength="2000" rows="5"></textarea></label><input name="website" class="contact-honeypot" tabindex="-1" autocomplete="off" aria-hidden="true" /><p class="review-status" id="review-status" role="status" aria-live="polite"></p><button class="contact-submit" type="submit">Submit review</button></form></section></main></div><script is:inline>
const productTitle = document.querySelector('h1')?.textContent?.trim() || '';
const getVariants = () => Array.from(document.querySelectorAll('.variant-group')).map(group => `${group.getAttribute('data-variant-name')}: ${group.querySelector('.variant-option.selected')?.getAttribute('data-value') || ''}`).filter(Boolean).join('; ');
const updateInquiryLinks = () => { const variants = getVariants(); const suffix = variants ? `\nSelected variants: ${variants}` : ''; const text = `I'm interested in this ${productTitle}, please send me a quote.${suffix}`; document.querySelectorAll('.whatsapp-inquiry').forEach(link => link.setAttribute('href', `https://wa.me/85265426672?text=${encodeURIComponent(text)}`)); document.querySelectorAll('.email-inquiry').forEach(link => link.setAttribute('href', `mailto:info@maesvanti.online?subject=${encodeURIComponent(`Quote request: ${productTitle}`)}&body=${encodeURIComponent(text)}`)); };
document.querySelectorAll('.variant-option').forEach(button => button.addEventListener('click', () => { const group=button.closest('.variant-group'); group?.querySelectorAll('.variant-option').forEach(item => { item.classList.remove('selected'); item.setAttribute('aria-pressed','false'); }); button.classList.add('selected'); button.setAttribute('aria-pressed','true'); updateInquiryLinks(); }));
document.querySelectorAll('.media-thumb').forEach(button => button.addEventListener('click', () => { const hero=document.querySelector('#media-hero'); if(!hero)return; const url=button.getAttribute('data-url')||''; const alt=button.getAttribute('data-alt')||''; hero.innerHTML=button.getAttribute('data-type')==='video'?`<video src="${url}" controls></video>`:`<img src="${url}" alt="${alt}"/>`; document.querySelectorAll('.media-thumb').forEach(item=>item.classList.remove('active')); button.classList.add('active'); })); updateInquiryLinks();
const form=document.querySelector('#review-form'); const status=document.querySelector('#review-status'); form?.addEventListener('submit', async event => { event.preventDefault(); const submit=form.querySelector('button[type="submit"]'); if(submit)submit.disabled=true; if(status)status.textContent='Sending review…'; const data=Object.fromEntries(new FormData(form)); const variants=getVariants(); const reviewMessage=`Rating: ${data.rating}/5\nTitle: ${data.title||''}\nReview: ${data.body}\nSelected variants: ${variants||'None'}`; try { const response=await fetch('/api/contact',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({name:data.name,email:data.email,website:data.website,product:`Review · ${productTitle}`,message:reviewMessage})}); const result=await response.json(); if(!response.ok)throw new Error(result.error||'Unable to submit review.'); form.reset(); if(status)status.textContent='Thanks — your review has been submitted for approval.'; } catch(error) { if(status)status.textContent=error instanceof Error?error.message:'Unable to submit review.'; } finally { if(submit)submit.disabled=false; } });
</script></Layout>
