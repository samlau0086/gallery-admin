---
import Layout from '../../layouts/Layout.astro';
import { site } from '../../data/site';
import { absoluteUrl, productSeoTitle, toMetaDescription } from '../../data/seo';
import '../../styles/global.css';
import '../../styles/overrides.css';
export const prerender = false;
const runtime = (Astro.locals as App.Locals & { runtime?: { env?: { ASSETS?: { fetch: (request: Request | string) => Promise<Response> } } } }).runtime;
const response = runtime?.env?.ASSETS ? await runtime.env.ASSETS.fetch(new Request(new URL(`/product-data/${Astro.params.slug}.json`, Astro.url))) : await fetch(new URL(`/product-data/${Astro.params.slug}.json`, Astro.url));
const product = response.ok ? await response.json() : null;
if(!product||!product.published)return Astro.redirect('/');
const media=product.media.length?product.media:[{url:product.cover,type:'image',alt:product.title}];
const imageUrls=[product.cover,...media.filter((item:{url:string;type:string})=>item.type==='image').map((item:{url:string})=>item.url)].filter((url:string,index:number,urls:string[])=>Boolean(url)&&urls.indexOf(url)===index);
const reviews: Array<{ author: string; email?: string; rating: number; title?: string; body: string; images?: string[]; date?: string; variants?: string }> = product.reviews??[];
const average=reviews.length?reviews.reduce((sum:number,r)=>sum+r.rating,0)/reviews.length:0;
const message="I'm interested in this "+product.title+', please send me a quote';
const whatsappHref=site.contact.whatsapp+'?text='+encodeURIComponent(message);
const emailHref=site.contact.email+'?subject='+encodeURIComponent('Quote request: '+product.title)+'&body='+encodeURIComponent(message);
const seoTitle = productSeoTitle(product);
const metaDescription = toMetaDescription(product.description || product.title);
const canonical = absoluteUrl(`/products/${product.slug}/`);
const productImages = imageUrls.map(absoluteUrl);
const productName = [product.brand, product.category, product.sku ? `SKU ${product.sku}` : ''].filter(Boolean).join(' ') || product.title;
const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: productName,
  description: metaDescription,
  image: productImages,
  sku: product.sku || undefined,
  category: product.category || undefined,
  brand: product.brand ? { '@type': 'Brand', name: product.brand } : undefined,
  aggregateRating: reviews.length ? { '@type': 'AggregateRating', ratingValue: Number(average.toFixed(1)), reviewCount: reviews.length } : undefined,
};
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Collection', item: absoluteUrl('/') },
    { '@type': 'ListItem', position: 2, name: productName, item: canonical },
  ],
};
---
<Layout title={`${seoTitle} | ${site.name}`} description={metaDescription} canonical={canonical} image={product.cover} type="product" jsonLd={[productSchema, breadcrumbSchema]}><div class="app-shell"><header class="app-header"><div class="header-inner"><a class="brand-lockup" href="/"><span class="brand-mark">{site.name.slice(0,1)}</span><span>{site.name}</span></a><div class="header-right"><a class="icon-link inquiry-link whatsapp-inquiry" data-inquiry-product data-inquiry-channel="whatsapp" data-product-title={product.title} data-product-sku={product.sku??''} data-product-image={product.cover} href={whatsappHref}>WhatsApp</a><a class="icon-link inquiry-link email-inquiry" data-inquiry-product data-inquiry-channel="email" data-product-title={product.title} data-product-sku={product.sku??''} data-product-image={product.cover} href={emailHref}>Email</a></div></div></header><main class="shell detail" data-product-slug={product.slug}><a class="back" href="/">← Back to collection</a><div class="detail-grid"><div class="media-stack"><div class="media-hero" id="media-hero">{media[0].type==='video'?<video src={media[0].url} controls />:<img src={media[0].url} alt={media[0].alt??product.title}/>}</div><div class="media-thumbs">{media.map((item,index)=><button class={`media-thumb ${index===0?'active':''}`} data-url={item.url} data-type={item.type} data-alt={item.alt??product.title} type="button">{item.type==='video'?<span>▶</span>:<img src={item.url} alt=""/>}</button>)}</div></div><aside class="detail-copy"><p class="muted">{product.category}</p><h1>{product.title}</h1>{reviews.length>0&&<div class="rating-summary"><span class="stars">{'★'.repeat(Math.round(average))}{'☆'.repeat(5-Math.round(average))}</span><a href="#reviews">{average.toFixed(1)} · {reviews.length} Reviews</a></div>}{product.price&&<p class="product-price">{product.price}</p>}{product.sku&&<p class="sku">SKU · {product.sku}</p>}{product.variants.map(variant=><fieldset class="variant-group" data-variant-name={variant.name}><legend>{variant.name}</legend><div>{variant.options.map((option,i)=><button class={`variant-option ${i===0?'selected':''}`} aria-pressed={i===0} data-value={option} type="button">{option}</button>)}</div></fieldset>)}<button class="add-to-basket-button" type="button" data-add-to-basket data-product-id={product.slug} data-product-title={product.title} data-product-sku={product.sku??''} data-product-image={product.cover} data-product-url={'/products/'+product.slug+'/'}><img src="/cart.svg" alt="" />Add to basket</button><button class="download-images-button" type="button" data-download-images data-product-slug={product.slug} data-image-urls={JSON.stringify(imageUrls)}>Download all images ({imageUrls.length})</button><p class="download-images-status" data-download-images-status aria-live="polite"></p><div class="contact-links"><a class="contact-link inquiry-link whatsapp-inquiry" data-inquiry-product data-inquiry-channel="whatsapp" data-product-title={product.title} data-product-sku={product.sku??''} data-product-image={product.cover} href={whatsappHref}>WhatsApp enquiry</a><a class="contact-link inquiry-link email-inquiry" data-inquiry-product data-inquiry-channel="email" data-product-title={product.title} data-product-sku={product.sku??''} data-product-image={product.cover} href={emailHref}>Email enquiry</a></div><div class="muted detail-body"><div class="detail-body-content" id="detail-body-content">{product.description && <p>{product.description}</p>}</div><button class="detail-body-toggle" id="detail-body-toggle" type="button" aria-expanded="false" hidden>View more</button></div></aside></div><section class="reviews-section" id="reviews"><div class="reviews-heading"><h2>Reviews</h2>{reviews.length>0&&<span>{average.toFixed(1)} / 5 · {reviews.length} reviews</span>}</div>{reviews.length>0?<div class="reviews-list">{reviews.map(review=><article class="review"><div class="review-top"><strong>{review.author}</strong><span class="stars">{'★'.repeat(review.rating)}{'☆'.repeat(5-review.rating)}</span><small>{review.date}</small></div>{review.title&&<h3>{review.title}</h3>}<p>{review.body}</p>{review.images?.length ? <div class="review-images">{review.images.map((image) => <a href={image} data-review-image><img src={image} alt={`Photo from ${review.author}'s review`} loading="lazy" /></a>)}</div> : null}</article>)}</div>:<p class="empty-reviews">No reviews yet.</p>}<form class="review-form" id="review-form"><h3>Write a review</h3><div class="review-form-grid"><label>Name<input name="name" required maxlength="100" /></label><label>Email<input name="email" type="email" required maxlength="200" /></label></div><label>Rating<select name="rating" required><option value="5">5 stars</option><option value="4">4 stars</option><option value="3">3 stars</option><option value="2">2 stars</option><option value="1">1 star</option></select></label><label>Title<input name="title" maxlength="160" /></label><label>Review<textarea name="body" required minlength="10" maxlength="2000" rows="5"></textarea></label><input name="website" class="contact-honeypot" tabindex="-1" autocomplete="off" aria-hidden="true" /><p class="review-status" id="review-status" role="status" aria-live="polite"></p><button class="contact-submit" type="submit">Submit review</button></form></section></main></div><script is:inline>document.addEventListener("astro:page-load", () => {
const productTitle = document.querySelector('h1')?.textContent?.trim() || ''; const productSlug = document.querySelector('main[data-product-slug]')?.getAttribute('data-product-slug') || '';
const productSku = document.querySelector('.sku')?.textContent?.replace(/^SKU\s*[·.]\s*/, '').trim() || '';
const productImage = document.querySelector('#media-hero img')?.getAttribute('src') || '';
document.querySelectorAll('[data-inquiry-product]').forEach((element) => {
  if (element.closest('.detail')) return;
  element.dataset.productTitle = productTitle;
  element.dataset.productSku = productSku;
  element.dataset.productImage = productImage;
});
const getVariants = () => Array.from(document.querySelectorAll('.variant-group')).map(group => `${group.getAttribute('data-variant-name')}: ${group.querySelector('.variant-option.selected')?.getAttribute('data-value') || ''}`).filter(Boolean).join('; ');
const updateInquiryLinks = () => { const variants = getVariants(); const suffix = variants ? '\nSelected variants: '+variants : ''; const text = "I'm interested in this "+productTitle+', please send me a quote.'+suffix; document.querySelectorAll('.whatsapp-inquiry').forEach(link => link.setAttribute('href', 'https://wa.me/85265426672?text='+encodeURIComponent(text))); document.querySelectorAll('.email-inquiry').forEach(link => link.setAttribute('href', 'mailto:info@maesvanti.online?subject='+encodeURIComponent('Quote request: '+productTitle)+'&body='+encodeURIComponent(text))); };
document.querySelectorAll('.variant-option').forEach(button => button.addEventListener('click', () => { const group=button.closest('.variant-group'); group?.querySelectorAll('.variant-option').forEach(item => { item.classList.remove('selected'); item.setAttribute('aria-pressed','false'); }); button.classList.add('selected'); button.setAttribute('aria-pressed','true'); updateInquiryLinks(); }));
document.querySelectorAll('.media-thumb').forEach(button => button.addEventListener('click', () => { const hero=document.querySelector('#media-hero'); if(!hero)return; const url=button.getAttribute('data-url')||''; const alt=button.getAttribute('data-alt')||''; if(button.getAttribute('data-type')==='video'){const video=document.createElement('video');video.src=url;video.controls=true;hero.replaceChildren(video);}else{const image=document.createElement('img');image.src=url;image.alt=alt;hero.replaceChildren(image);} document.querySelectorAll('.media-thumb').forEach(item=>item.classList.remove('active')); button.classList.add('active'); }));
const reviewImages = document.querySelectorAll('[data-review-image]');
let reviewLightbox;
const closeReviewLightbox = () => { if (!reviewLightbox) return; reviewLightbox.hidden = true; document.body.classList.remove('review-lightbox-open'); };
reviewImages.forEach((link) => link.addEventListener('click', (event) => {
  event.preventDefault();
  if (!reviewLightbox) {
    reviewLightbox = document.createElement('div');
    reviewLightbox.className = 'review-lightbox';
    reviewLightbox.hidden = true;
    reviewLightbox.setAttribute('role', 'dialog');
    reviewLightbox.setAttribute('aria-modal', 'true');
    reviewLightbox.innerHTML = '<div class="review-lightbox-backdrop"></div><div class="review-lightbox-content"><button class="review-lightbox-close" type="button" aria-label="Close image">×</button><img alt=""></div>';
    document.body.appendChild(reviewLightbox);
    reviewLightbox.querySelector('.review-lightbox-backdrop')?.addEventListener('click', closeReviewLightbox);
    reviewLightbox.querySelector('.review-lightbox-close')?.addEventListener('click', closeReviewLightbox);
    reviewLightbox.querySelector('.review-lightbox-content')?.addEventListener('click', (clickEvent) => clickEvent.stopPropagation());
  }
  const image = reviewLightbox.querySelector('img');
  if (image) { image.src = link.getAttribute('href') || ''; image.alt = link.querySelector('img')?.getAttribute('alt') || ''; }
  reviewLightbox.hidden = false;
  document.body.classList.add('review-lightbox-open');
}));
document.addEventListener('keydown', (event) => { if (event.key === 'Escape') closeReviewLightbox(); });
updateInquiryLinks();
const detailBody = document.querySelector('#detail-body-content'); const detailBodyToggle = document.querySelector('#detail-body-toggle');
if (detailBody && detailBodyToggle) { const maxHeight = 450; const updateDetailBody = () => { const overflowing = detailBody.scrollHeight > maxHeight; detailBodyToggle.hidden = !overflowing; if (!overflowing) detailBody.classList.remove('is-collapsed'); }; updateDetailBody(); detailBodyToggle.addEventListener('click', () => { const expanded = detailBody.classList.toggle('is-expanded'); detailBody.classList.toggle('is-collapsed', !expanded); detailBodyToggle.setAttribute('aria-expanded', String(expanded)); detailBodyToggle.textContent = expanded ? 'View less' : 'View more'; }); }
const form=document.querySelector('#review-form'); const status=document.querySelector('#review-status'); form?.addEventListener('submit', async event => { event.preventDefault(); const submit=form.querySelector('button[type="submit"]'); if(submit)submit.disabled=true; if(status)status.textContent='Sending review…'; const data=Object.fromEntries(new FormData(form)); const variants=getVariants(); try { const response=await fetch('/api/reviews',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({name:data.name,email:data.email,website:data.website,rating:data.rating,title:data.title,variants,product:productSlug,body:data.body})}); const result=await response.json(); if(!response.ok)throw new Error(result.error||'Unable to submit review.'); form.reset(); if(status)status.textContent='Thanks — your review has been submitted for approval.'; } catch(error) { if(status)status.textContent=error instanceof Error?error.message:'Unable to submit review.'; } finally { if(submit)submit.disabled=false; } });
});</script><script src="../../scripts/download-product-images.ts"></script></Layout>
