---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { site } from '../data/site';
import '../styles/global.css';
import '../styles/overrides.css';
const query=(Astro.url.searchParams.get('q')||'').trim();
const q=query.toLowerCase();
const products=(await getCollection('products',({data})=>data.published)).filter(({data})=>!q||[data.title,data.titleZh,data.category,...data.tags].filter(Boolean).join(' ').toLowerCase().includes(q)).sort((a,b)=>a.data.sortOrder-b.data.sortOrder);
---
<Layout title={'Search'+(query?' : '+query:'')+' | '+site.name} description="Search the collection">
<main class="content-column search-page"><form class="search-page-form" action="/search" method="get"><span class="search-icon">⌕</span><input class="search-page-input" name="q" value={query} placeholder="Search collection" aria-label="Search collection" /><button type="submit">Search</button></form><h1 class="search-page-heading">{query?products.length+' result'+(products.length===1?'':'s')+' for “'+query+'”':'Search collection'}</h1>{query&&!products.length?<p class="search-empty-page">No matching works.</p>:<section class="product-grid">{products.map(product=><a class="product-card" data-product-title={product.data.title} data-product-sku={product.data.sku??''} data-product-image={product.data.cover} href={'/products/'+product.slug+'/'}><div class="image-frame"><img src={product.data.cover} alt={product.data.title} loading="lazy" /></div><div class="product-copy"><strong>{product.data.titleZh??product.data.title}</strong><span>{product.data.title}</span><p>{product.data.description}</p></div><button class="inquiry-card-button" type="button" data-inquiry-product>WhatsApp inquiry</button></a>)}</section>}</main>
</Layout>
