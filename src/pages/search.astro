---
import Layout from '../layouts/Layout.astro';
import { site } from '../data/site';
import { localizedValue, productLocaleFromUrl } from '../data/product-i18n';
import '../styles/global.css';
import '../styles/overrides.css';
export const prerender = false;
const runtime = (Astro.locals as App.Locals & { runtime?: { env?: { ASSETS?: { fetch: (request: Request | string) => Promise<Response> } } } }).runtime;
const response = runtime?.env?.ASSETS ? await runtime.env.ASSETS.fetch(new Request(new URL('/search-index.json', Astro.url))) : await fetch(new URL('/search-index.json', Astro.url));
const productsData = response.ok ? await response.json() : [];
const query=(Astro.url.searchParams.get('q')||'').trim();
const q=query.toLowerCase();
const locale = productLocaleFromUrl(Astro.url);
const localizedValues = (value: unknown) => value && typeof value === 'object' ? Object.values(value as Record<string, unknown>) : [value];
const productTitle = (product: any) => localizedValue(product.i18n?.title || product.title, locale, product.title || "");
const productDescription = (product: any) => localizedValue(product.i18n?.description || product.description, locale, '');
const products=productsData.filter((product: any)=>product.published !== false&&(!q||[
  ...localizedValues(product.i18n?.title),
  ...localizedValues(product.i18n?.description),
  ...localizedValues(product.i18n?.category),
  product.title,
  product.category,
  product.description,
  product.brand,
  product.sku,
  ...(product.tags || []),
].filter(Boolean).join(' ').toLowerCase().includes(q))).sort((a: any,b: any)=>a.sortOrder-b.sortOrder);
---
<Layout title={'Search'+(query?' : '+query:'')+' | '+site.name} description="Search the collection">
<main class="content-column search-page"><form class="search-page-form" action="/search" method="get"><span class="search-icon">⌕</span><input class="search-page-input" name="q" value={query} placeholder="Search collection" aria-label="Search collection" /><button type="submit">Search</button></form><h1 class="search-page-heading">{query?products.length+' result'+(products.length===1?'':'s')+' for “'+query+'”':'Search collection'}</h1>{query&&!products.length?<p class="search-empty-page">No matching works.</p>:<section class="product-grid">{products.map((product: any)=>{const title=productTitle(product);const description=productDescription(product);const productUrl='/products/'+product.slug+'/?lang='+locale;return <a class="product-card" data-product-title={title} data-product-sku={product.sku??''} data-product-image={product.cover} href={productUrl}><div class="image-frame"><img src={product.cover} alt={title} loading="lazy" /></div><div class="product-copy"><strong>{title}</strong><span>{localizedValue(product.i18n?.category || product.category, locale, product.category || '')}</span><p>{description}</p></div><button class="basket-card-button" type="button" data-add-to-basket data-product-id={product.slug} data-product-title={title} data-product-sku={product.sku??''} data-product-image={product.cover} data-product-url={productUrl}><img src="/cart.svg" alt="" />Add to basket</button></a>})}</section>}</main>
</Layout>
<script src="/deduplicate.js" defer></script>