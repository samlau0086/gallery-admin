---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { site, categories } from '../data/site';
import '../styles/global.css';
const products = (await getCollection('products', ({ data }) => data.published)).sort((a,b) => a.data.sortOrder - b.data.sortOrder);
const categoryItems = categories.filter((category) => category !== 'All');
---
<Layout title={site.name} description={site.tagline}>
  <div class="app-shell">
    <header class="app-header"><div class="header-inner"><div class="header-left"><button class="header-tool category-trigger" type="button" aria-expanded="false" aria-controls="category-panel"><span class="tool-icon">☷</span><span>Category</span></button><button class="header-tool search-trigger" type="button" aria-expanded="false" aria-controls="search-panel"><span class="tool-icon">⌕</span><span>Search</span></button></div><a class="brand-lockup" href="/"><span class="brand-mark">{site.name.slice(0,1)}</span><span>{site.name}</span></a><div class="header-right"><a class="app-link" href="/admin/" title="Open admin"><span class="app-glyph">▲</span> 打开APP</a><button class="icon-button" type="button" aria-label="Change language">◎</button><button class="avatar" type="button" aria-label="Account">A</button></div></div></header>
    <div class="search-panel" id="search-panel" hidden><div class="search-wrap"><span class="search-icon">⌕</span><input class="search" type="search" placeholder="Search collection" aria-label="Search collection" /></div></div>
    <div class="category-panel" id="category-panel" hidden><div class="category-list"><button class="category-option active" type="button" data-category="All">All products</button>{categoryItems.map((category) => <button class="category-option" type="button" data-category={category}>{category}</button>)}</div><div class="category-feature"><span class="eyebrow">Curated collection</span><strong>{site.tagline}</strong><span class="feature-arrow">↗</span></div></div>
    <main class="content-column"><section class="collection-head" id="collection"><div class="tabs" role="tablist"><button class="tab active" type="button" data-category="All">All</button><button class="tab" type="button" data-kind="new">New</button><button class="tab" type="button" data-kind="video">Video</button><button class="tab" type="button" data-kind="photos">Photos</button></div><div class="view-controls"><span class="collection-count">{products.length} works</span><button class="view-button" type="button" aria-label="Change grid view" aria-expanded="false">▦</button><div class="view-menu" hidden><button type="button" data-view="grid">▦ &nbsp; Gallery</button><button type="button" data-view="large">▤ &nbsp; Large image</button><button type="button" data-view="list">☷ &nbsp; List view</button></div></div></section><div class="collection-label">{categoryItems[0] ?? 'Collection'}</div><section class="product-grid" id="product-grid">{products.map((product) => <a class="product-card" data-category={product.data.category} data-kind={product.data.featured ? 'new' : 'photos'} data-search={(product.data.title+' '+(product.data.titleZh??'')+' '+product.data.tags.join(' ')).toLowerCase()} href={'/products/'+product.slug+'/'}><div class="image-frame"><img src={product.data.cover} alt={product.data.title} loading="lazy"/><span class="share-mark">↗</span></div><div class="product-copy"><strong>{product.data.titleZh ?? product.data.title}</strong><span>{product.data.title}</span><p>{product.data.description}</p></div></a>)}</section></main>
    <button class="help-button" type="button" aria-label="Contact support">◌<span>Contact us</span></button>
  </div>
</Layout>
<script>
const cards=[...document.querySelectorAll<HTMLElement>('.product-card')],categoryButtons=[...document.querySelectorAll<HTMLElement>('[data-category]')],tabs=[...document.querySelectorAll<HTMLElement>('.tab')],search=document.querySelector<HTMLInputElement>('.search'),grid=document.querySelector<HTMLElement>('#product-grid');let activeCategory='All',activeKind='';const filter=()=>{const query=(search?.value||'').toLowerCase();cards.forEach(card=>{const categoryMatch=activeCategory==='All'||card.dataset.category===activeCategory;const kindMatch=!activeKind||card.dataset.kind===activeKind;card.hidden=!(categoryMatch&&kindMatch&&(!query||card.dataset.search?.includes(query)))})};categoryButtons.forEach(button=>button.addEventListener('click',()=>{activeCategory=button.dataset.category||'All';document.querySelectorAll('.category-option').forEach(item=>item.classList.toggle('active',item===button));tabs.forEach(tab=>tab.classList.toggle('active',tab.dataset.category===activeCategory&&!activeKind));filter()}));tabs.forEach(tab=>tab.addEventListener('click',()=>{activeKind=tab.dataset.kind||'';if(tab.dataset.category)activeCategory=tab.dataset.category;tabs.forEach(item=>item.classList.toggle('active',item===tab));filter()}));search?.addEventListener('input',filter);const togglePanel=(selector:string,trigger:HTMLElement)=>{const panel=document.querySelector<HTMLElement>(selector);if(!panel)return;const open=!panel.hidden;panel.hidden=open;trigger.setAttribute('aria-expanded',String(!open))};document.querySelector<HTMLElement>('.category-trigger')?.addEventListener('click',event=>togglePanel('#category-panel',event.currentTarget as HTMLElement));document.querySelector<HTMLElement>('.search-trigger')?.addEventListener('click',event=>togglePanel('#search-panel',event.currentTarget as HTMLElement));const viewButton=document.querySelector<HTMLElement>('.view-button'),viewMenu=document.querySelector<HTMLElement>('.view-menu');viewButton?.addEventListener('click',()=>{if(!viewMenu)return;viewMenu.hidden=!viewMenu.hidden;viewButton.setAttribute('aria-expanded',String(!viewMenu.hidden))});viewMenu?.querySelectorAll<HTMLElement>('button').forEach(button=>button.addEventListener('click',()=>{grid?.classList.remove('view-large','view-list');if(button.dataset.view==='large')grid?.classList.add('view-large');if(button.dataset.view==='list')grid?.classList.add('view-list');if(viewMenu)viewMenu.hidden=true}));
</script>
