---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { site, categories } from '../data/site';
import '../styles/global.css';
import '../styles/overrides.css';
const products = (await getCollection('products', ({ data }) => data.published)).sort((a,b) => a.data.sortOrder - b.data.sortOrder);
const categoryItems = categories.filter((category) => category !== 'All');
---
<Layout title={site.name} description={site.tagline}>
<div class="app-shell">
<header class="app-header"><div class="header-inner">
<div class="header-left"><button class="header-tool category-trigger" type="button" aria-expanded="false"><span class="tool-icon">☷</span><span>Category</span></button><button class="header-tool search-trigger" type="button" aria-expanded="false"><span class="tool-icon">⌕</span><span>Search</span></button></div>
<a class="brand-lockup" href="/"><span class="brand-mark">{site.name.slice(0,1)}</span><span>{site.name}</span></a>
<div class="header-right"><a class="icon-link" href="https://wa.me/85265426672" aria-label="WhatsApp" title="WhatsApp">◉</a><a class="icon-link" href="mailto:info@maesvanti.online" aria-label="Email" title="Email">✉</a><button class="icon-link contact-trigger" type="button" aria-label="Contact" title="Contact">♧</button></div>
</div></header>
<div class="search-panel" id="search-panel" hidden><div class="search-wrap"><span class="search-icon">⌕</span><input class="search" type="search" placeholder="Search collection" aria-label="Search collection" /></div></div>
<div class="category-panel" id="category-panel" hidden><div class="category-list"><button class="category-option active" type="button" data-category="All">All products</button>{categoryItems.map((category) => <button class="category-option" type="button" data-category={category}>{category}</button>)}</div><div class="category-feature"><span class="eyebrow">Curated collection</span><strong>{site.tagline}</strong><span class="feature-arrow">↗</span></div></div>
<main class="content-column"><section class="collection-head"><div class="tabs"><button class="tab active" type="button" data-category="All">All</button><button class="tab" type="button" data-kind="new">New</button><button class="tab" type="button" data-kind="video">Video</button><button class="tab" type="button" data-kind="photos">Photos</button></div><div class="view-controls"><span class="collection-count">{products.length} works</span><button class="view-button" type="button" aria-label="Change grid view">▦</button><div class="view-menu" hidden><button type="button" data-view="grid">▦ Gallery</button><button type="button" data-view="large">▤ Large image</button><button type="button" data-view="list">☷ List view</button></div></div></section><div class="collection-label">{categoryItems[0] ?? 'Collection'}</div><section class="product-grid" id="product-grid">{products.map((product) => <a class="product-card" data-category={product.data.category} data-kind={product.data.featured ? 'new' : 'photos'} data-search={(product.data.title+' '+(product.data.titleZh??'')+' '+product.data.tags.join(' ')).toLowerCase()} href={'/products/'+product.slug+'/'}><div class="image-frame"><img src={product.data.cover} alt={product.data.title} loading="eager"/><span class="share-mark">↗</span></div><div class="product-copy"><strong>{product.data.titleZh ?? product.data.title}</strong><span>{product.data.title}</span><p>{product.data.description}</p></div></a>)}</section></main>
<a class="help-button" href="https://wa.me/85265426672" aria-label="WhatsApp">◉<span>WhatsApp</span></a>
</div>
<div class="contact-modal" id="contact-modal" hidden><div class="modal-backdrop"></div><section class="modal-card" role="dialog" aria-modal="true" aria-labelledby="contact-title"><button class="modal-close" type="button" aria-label="Close">×</button><span class="eyebrow">Get in touch</span><h2 id="contact-title">Contact us</h2><p>We would be happy to help with product details, sourcing and appointments.</p><div class="contact-links"><a href="https://wa.me/85265426672">WhatsApp</a><a href="mailto:info@maesvanti.online">info@maesvanti.online</a></div></section></div>
</Layout>
<script>
const cards=[...document.querySelectorAll<HTMLElement>('.product-card')],buttons=[...document.querySelectorAll<HTMLElement>('[data-category]')],tabs=[...document.querySelectorAll<HTMLElement>('.tab')],search=document.querySelector<HTMLInputElement>('.search'),grid=document.querySelector<HTMLElement>('#product-grid');let activeCategory='All',activeKind='';const filter=()=>{const q=(search?.value||'').toLowerCase();cards.forEach(card=>{card.hidden=!((activeCategory==='All'||card.dataset.category===activeCategory)&&(!activeKind||card.dataset.kind===activeKind)&&(!q||card.dataset.search?.includes(q)))})};buttons.forEach(button=>button.addEventListener('click',()=>{activeCategory=button.dataset.category||'All';filter()}));tabs.forEach(tab=>tab.addEventListener('click',()=>{activeKind=tab.dataset.kind||'';if(tab.dataset.category)activeCategory=tab.dataset.category;tabs.forEach(item=>item.classList.toggle('active',item===tab));filter()}));search?.addEventListener('input',filter);const categoryPanel=document.querySelector<HTMLElement>('#category-panel'),searchPanel=document.querySelector<HTMLElement>('#search-panel'),categoryTrigger=document.querySelector<HTMLElement>('.category-trigger'),searchTrigger=document.querySelector<HTMLElement>('.search-trigger');const closePanels=()=>{if(categoryPanel)categoryPanel.hidden=true;if(searchPanel)searchPanel.hidden=true;categoryTrigger?.setAttribute('aria-expanded','false');searchTrigger?.setAttribute('aria-expanded','false')};categoryTrigger?.addEventListener('click',()=>{const open=categoryPanel?.hidden===false;closePanels();if(categoryPanel)categoryPanel.hidden=open;categoryTrigger.setAttribute('aria-expanded',String(!open))});searchTrigger?.addEventListener('click',()=>{const open=searchPanel?.hidden===false;closePanels();if(searchPanel)searchPanel.hidden=open;searchTrigger.setAttribute('aria-expanded',String(!open))});const viewMenu=document.querySelector<HTMLElement>('.view-menu');document.querySelector('.view-button')?.addEventListener('click',()=>{if(viewMenu)viewMenu.hidden=!viewMenu.hidden});viewMenu?.querySelectorAll<HTMLElement>('button').forEach(button=>button.addEventListener('click',()=>{grid?.classList.remove('view-large','view-list');if(button.dataset.view==='large')grid?.classList.add('view-large');if(button.dataset.view==='list')grid?.classList.add('view-list');viewMenu.hidden=true}));const modal=document.querySelector<HTMLElement>('#contact-modal');const closeModal=()=>{if(modal)modal.hidden=true};document.querySelector('.contact-trigger')?.addEventListener('click',()=>{if(modal)modal.hidden=false});document.querySelector('.modal-close')?.addEventListener('click',closeModal);document.querySelector('.modal-backdrop')?.addEventListener('click',closeModal);document.addEventListener('keydown',event=>{if(event.key==='Escape')closeModal()});
</script>
