---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { site, categories, categorySlug } from '../data/site';
import '../styles/global.css';
import '../styles/overrides.css';
const products = (await getCollection('products', ({ data }) => data.published)).sort((a,b) => a.data.sortOrder - b.data.sortOrder);
const categoryItems = categories.filter((category) => category !== 'All');
---
<Layout title={site.name} description={site.tagline}>
<div class="app-shell">
<header class="app-header"><div class="header-inner">
<div class="header-left"><button class="header-tool category-trigger" type="button" aria-expanded="false"><span class="tool-icon">☷</span><span>Category</span></button><button class="header-tool search-trigger" type="button" aria-expanded="false"><span class="tool-icon">⌕</span><span>Search</span></button></div>
<a class="brand-lockup" href="/"><span class="brand-mark">{site.name.slice(0,1)}</span><span>{site.name}</span></a>
<div class="header-right"><a class="icon-link" href="https://wa.me/85265426672" aria-label="WhatsApp" title="WhatsApp"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 3.5A10.4 10.4 0 0 0 3.7 16.1L3 21l5-1.3A10.4 10.4 0 1 0 20.5 3.5Z"/><path d="M9 8.5c.2 1.8 1.7 4 4.3 5.1l1-.8"/></svg></a><a class="icon-link" href="mailto:info@maesvanti.online" aria-label="Email" title="Email"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m4 7 8 6 8-6"/></svg></a><button class="icon-link contact-trigger" type="button" aria-label="Contact" title="Contact"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5.5A2.5 2.5 0 0 1 6.5 3h11A2.5 2.5 0 0 1 20 5.5v7a2.5 2.5 0 0 1-2.5 2.5H12l-4.5 4v-4h-1A2.5 2.5 0 0 1 4 12.5v-7Z"/><path d="M8 8h8M8 11h5"/></svg></button></div>
</div></header>
<div class="search-panel" id="search-panel" hidden><div class="search-wrap"><span class="search-icon">⌕</span><input class="search" type="search" placeholder="Search collection" aria-label="Search collection" /></div></div>
<div class="category-panel" id="category-panel" hidden><nav class="category-list" role="tablist" aria-label="Categories"><button class="category-option active" role="tab" aria-selected="true" type="button" data-category="All">All products</button>{categoryItems.map((category) => <button class="category-option" role="tab" aria-selected="false" type="button" data-category={category}>{category}</button>)}</nav></div>
<main class="content-column"><section class="collection-head"><div class="tabs"><button class="tab active" type="button" data-category="All">All</button><button class="tab" type="button" data-kind="new">New</button><button class="tab" type="button" data-kind="video">Video</button><button class="tab" type="button" data-kind="photos">Photos</button></div><div class="view-controls"><span class="collection-count">{products.length} works</span><button class="view-button" type="button" aria-label="Change grid view">▦</button><div class="view-menu" hidden><button type="button" data-view="grid">▦ Gallery</button><button type="button" data-view="large">▤ Large image</button><button type="button" data-view="list">☷ List view</button></div></div></section><div class="collection-label" id="collection-label">All products</div><section class="product-grid" id="product-grid">{products.map((product) => <a class="product-card" data-category={product.data.category} data-kind={product.data.featured ? 'new' : 'photos'} data-search={(product.data.title+' '+(product.data.titleZh??'')+' '+product.data.tags.join(' ')).toLowerCase()} href={'/products/'+product.slug+'/'}><div class="image-frame"><img src={product.data.cover} alt={product.data.title} loading="eager"/><span class="share-mark">↗</span></div><div class="product-copy"><strong>{product.data.titleZh ?? product.data.title}</strong><span>{product.data.title}</span><p>{product.data.description}</p></div></a>)}</section></main>
<a class="help-button" href="https://wa.me/85265426672" aria-label="WhatsApp">◉<span>WhatsApp</span></a>
</div>
<div class="contact-modal" id="contact-modal" hidden><div class="modal-backdrop"></div><section class="modal-card" role="dialog" aria-modal="true" aria-labelledby="contact-title"><button class="modal-close" type="button" aria-label="Close">×</button><span class="eyebrow">Get in touch</span><h2 id="contact-title">Contact us</h2><p>We would be happy to help with product details, sourcing and appointments.</p><div class="contact-links"><a href="https://wa.me/85265426672">WhatsApp</a><a href="mailto:info@maesvanti.online">info@maesvanti.online</a></div></section></div>
</Layout>
<script>
const cards=[...document.querySelectorAll<HTMLElement>('.product-card')],buttons=[...document.querySelectorAll<HTMLElement>('.category-option')],tabs=[...document.querySelectorAll<HTMLElement>('.tab')],search=document.querySelector<HTMLInputElement>('.search'),grid=document.querySelector<HTMLElement>('#product-grid'),label=document.querySelector<HTMLElement>('#collection-label');let activeCategory='All',activeKind='';const initialCategory=new URLSearchParams(location.search).get('category');const initialButton=buttons.find(button=>button.dataset.category?.toLowerCase()===initialCategory);if(initialButton)activeCategory=initialButton.dataset.category||'All';const filter=()=>{const q=(search?.value||'').toLowerCase();cards.forEach(card=>{card.hidden=!((activeCategory==='All'||card.dataset.category===activeCategory)&&(!activeKind||card.dataset.kind===activeKind)&&(!q||card.dataset.search?.includes(q)))})};const setCategory=(category:string)=>{activeCategory=category;activeKind='';buttons.forEach(button=>{const selected=button.dataset.category===category;button.classList.toggle('active',selected);button.setAttribute('aria-selected',String(selected))});tabs.forEach(tab=>tab.classList.toggle('active',tab.dataset.category===category));if(label)label.textContent=category==='All'?'All products':category;filter()};buttons.forEach(button=>button.addEventListener('click',()=>{const category=button.dataset.category||'All';setCategory(category);closePanels()}));tabs.forEach(tab=>tab.addEventListener('click',()=>{activeKind=tab.dataset.kind||'';if(tab.dataset.category)setCategory(tab.dataset.category);tabs.forEach(item=>item.classList.toggle('active',item===tab));filter()}));search?.addEventListener('input',filter);const categoryPanel=document.querySelector<HTMLElement>('#category-panel'),searchPanel=document.querySelector<HTMLElement>('#search-panel'),categoryTrigger=document.querySelector<HTMLElement>('.category-trigger'),searchTrigger=document.querySelector<HTMLElement>('.search-trigger');const closePanels=()=>{if(categoryPanel)categoryPanel.hidden=true;if(searchPanel)searchPanel.hidden=true;categoryTrigger?.setAttribute('aria-expanded','false');searchTrigger?.setAttribute('aria-expanded','false')};categoryTrigger?.addEventListener('click',()=>{const open=categoryPanel?.hidden===false;closePanels();if(categoryPanel)categoryPanel.hidden=open;categoryTrigger.setAttribute('aria-expanded',String(!open))});searchTrigger?.addEventListener('click',()=>{const open=searchPanel?.hidden===false;closePanels();if(searchPanel)searchPanel.hidden=open;searchTrigger.setAttribute('aria-expanded',String(!open))});const viewMenu=document.querySelector<HTMLElement>('.view-menu');document.querySelector('.view-button')?.addEventListener('click',()=>{if(viewMenu)viewMenu.hidden=!viewMenu.hidden});viewMenu?.querySelectorAll<HTMLElement>('button').forEach(button=>button.addEventListener('click',()=>{grid?.classList.remove('view-large','view-list');if(button.dataset.view==='large')grid?.classList.add('view-large');if(button.dataset.view==='list')grid?.classList.add('view-list');viewMenu.hidden=true}));const modal=document.querySelector<HTMLElement>('#contact-modal');const closeModal=()=>{if(modal)modal.hidden=true};document.querySelector('.contact-trigger')?.addEventListener('click',()=>{if(modal)modal.hidden=false});document.querySelector('.modal-close')?.addEventListener('click',closeModal);document.querySelector('.modal-backdrop')?.addEventListener('click',closeModal);document.addEventListener('keydown',event=>{if(event.key==='Escape')closeModal()});
</script>




