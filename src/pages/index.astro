---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { site } from '../data/site';
import '../styles/global.css';
import '../styles/overrides.css';
const products = (await getCollection('products', ({ data }) => data.published)).sort((a,b) => a.data.sortOrder - b.data.sortOrder);
const initialProducts = products.slice(0, 24);
const deferredProducts = products.slice(24).map(({ slug, data }) => ({
  slug,
  title: data.title,
  titleZh: data.titleZh ?? '',
  category: data.category,
  featured: data.featured,
  cover: data.cover,
  description: data.description ?? '',
  tags: data.tags
}));
---
<Layout title={site.name} description={site.tagline}>
<div class="app-shell">
<main class="content-column"><section class="collection-head"><div class="tabs"><button class="tab active" type="button" data-category="All">All</button><button class="tab" type="button" data-kind="new">New</button><button class="tab" type="button" data-kind="video">Video</button><button class="tab" type="button" data-kind="photos">Photos</button></div><div class="view-controls"><span class="collection-count">{products.length} works</span><button class="view-button" type="button" aria-label="Change grid view">▦</button><div class="view-menu" hidden><button type="button" data-view="grid">▦ Gallery</button><button type="button" data-view="large">▤ Large image</button><button type="button" data-view="list">☷ List view</button></div></div></section><div class="collection-label" id="collection-label">All products</div><section class="product-grid" id="product-grid">{initialProducts.map((product, index) => <a class="product-card" data-category={product.data.category} data-kind={product.data.featured ? 'new' : 'photos'} data-search={(product.data.title+' '+(product.data.titleZh??'')+' '+product.data.tags.join(' ')).toLowerCase()} href={'/products/'+product.slug+'/'}><div class="image-frame"><img src={product.data.cover} alt={product.data.title} width="1200" height="1600" loading={index === 0 ? 'eager' : 'lazy'} fetchpriority={index === 0 ? 'high' : 'auto'} decoding="async"/><span class="share-mark">↗</span></div><div class="product-copy"><strong>{product.data.titleZh ?? product.data.title}</strong><span>{product.data.title}</span><p>{product.data.description}</p></div></a>)}</section><div id="load-more-sentinel" aria-hidden="true"></div><p class="load-more-status" id="load-more-status" aria-live="polite"></p><script type="application/json" id="deferred-products" set:html={JSON.stringify(deferredProducts)}></script></main>
<a class="help-button" href="https://wa.me/85265426672" aria-label="WhatsApp" title="WhatsApp">◉</a>
</div>
<div class="contact-modal" id="contact-modal" hidden><div class="modal-backdrop"></div><section class="modal-card" role="dialog" aria-modal="true" aria-labelledby="contact-title"><button class="modal-close" type="button" aria-label="Close">×</button><span class="eyebrow">Get in touch</span><h2 id="contact-title">Contact us</h2><p>We would be happy to help with product details, sourcing and appointments.</p><div class="contact-links"><a href="https://wa.me/85265426672">WhatsApp</a><a href="mailto:info@maesvanti.online">info@maesvanti.online</a></div></section></div>
</Layout>
<script>
const contactCard=document.querySelector<HTMLElement>('#contact-modal .modal-card');if(contactCard){const intro=contactCard.querySelector('.contact-links');if(intro){intro.innerHTML='<form class="contact-form" id="contact-form"><label>Name<input name="name" required maxlength="100" autocomplete="name" /></label><label>Email<input name="email" type="email" required maxlength="200" autocomplete="email" /></label><label>WhatsApp (optional)<input name="whatsapp" maxlength="40" autocomplete="tel" /></label><label>Message<textarea name="message" required minlength="10" maxlength="4000" rows="5"></textarea></label><input class="contact-honeypot" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" /><p class="contact-status" id="contact-status" role="status" aria-live="polite"></p><button class="contact-submit" type="submit">Send message</button></form>';const form=document.querySelector<HTMLFormElement>('#contact-form'),status=document.querySelector<HTMLElement>('#contact-status');form?.addEventListener('submit',async event=>{event.preventDefault();const submit=form.querySelector<HTMLButtonElement>('button[type=submit]');if(!submit)return;submit.disabled=true;if(status)status.textContent='Sending…';try{const response=await fetch('/api/contact',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify(Object.fromEntries(new FormData(form)))});const data=await response.json();if(!response.ok)throw new Error(data.error||'Unable to send your message.');form.reset();if(status)status.textContent='Thanks — your message has been sent.'}catch(error){if(status)status.textContent=error instanceof Error?error.message:'Unable to send your message.'}finally{submit.disabled=false}})}}
</script>

<script is:inline>
const deferredNode=document.querySelector('#deferred-products');
const productGrid=document.querySelector<HTMLElement>('#product-grid');
const loadSentinel=document.querySelector('#load-more-sentinel');
let deferredProducts=JSON.parse(deferredNode?.textContent||'[]');
let allProductCards=[...document.querySelectorAll<HTMLElement>('.product-card')];
let activeListCategory=document.querySelector('.category-option.active')?.getAttribute('data-category')||'All',activeListKind='';
const makeProductCard=(product)=>{const link=document.createElement('a');link.className='product-card';link.href=`/products/${product.slug}/`;link.dataset.category=product.category;link.dataset.kind=product.featured?'new':'photos';link.dataset.search=`${product.title} ${product.titleZh||''} ${(product.tags||[]).join(' ')}`.toLowerCase();link.innerHTML=`<div class="image-frame"><img src="${product.cover}" alt="${product.title}" width="1200" height="1600" loading="lazy" decoding="async"><span class="share-mark">↗</span></div><div class="product-copy"><strong>${product.titleZh||product.title}</strong><span>${product.title}</span><p>${product.description||''}</p></div>`;return link};
const applyListFilter=()=>{const searchInput=document.querySelector('.search');const q=(searchInput?.value||'').toLowerCase();allProductCards.forEach(card=>{card.hidden=!((activeListCategory==='All'||card.dataset.category===activeListCategory)&&(!activeListKind||card.dataset.kind===activeListKind)&&(!q||card.dataset.search?.includes(q)))})};
const appendProducts=()=>{if(!productGrid||!deferredProducts.length)return;const batch=deferredProducts.splice(0,24);const fragment=document.createDocumentFragment();batch.forEach(product=>fragment.appendChild(makeProductCard(product)));productGrid.appendChild(fragment);allProductCards=[...document.querySelectorAll('.product-card')];applyListFilter()};
if(loadSentinel&&'IntersectionObserver' in window){const loadObserver=new IntersectionObserver(entries=>{if(entries.some(entry=>entry.isIntersecting))appendProducts()},{rootMargin:'700px'});loadObserver.observe(loadSentinel)}
document.querySelectorAll<HTMLElement>('.category-option').forEach(button=>button.addEventListener('click',()=>{activeListCategory=button.dataset.category||'All';activeListKind='';applyListFilter()}));
document.querySelectorAll<HTMLElement>('.tab').forEach(tab=>tab.addEventListener('click',()=>{activeListKind=tab.dataset.kind||'';if(tab.dataset.category)activeListCategory=tab.dataset.category;applyListFilter()}));
document.querySelector<HTMLInputElement>('.search')?.addEventListener('input',applyListFilter);
</script>
<script>
const headerCategoryPanel=document.querySelector<HTMLElement>('#global-category-panel');
const headerSearchPanel=document.querySelector<HTMLElement>('#global-search-panel');
const headerCategoryTrigger=document.querySelector<HTMLElement>('.category-trigger');
const headerSearchTrigger=document.querySelector<HTMLElement>('.search-trigger');
const closeHeaderPanels=()=>{if(headerCategoryPanel)headerCategoryPanel.hidden=true;if(headerSearchPanel)headerSearchPanel.hidden=true;headerCategoryTrigger?.setAttribute('aria-expanded','false');headerSearchTrigger?.setAttribute('aria-expanded','false')};
headerCategoryTrigger?.addEventListener('click',()=>{const open=headerCategoryPanel?.hidden===false;closeHeaderPanels();if(headerCategoryPanel)headerCategoryPanel.hidden=open;headerCategoryTrigger.setAttribute('aria-expanded',String(!open))});
headerSearchTrigger?.addEventListener('click',()=>{const open=headerSearchPanel?.hidden===false;closeHeaderPanels();if(headerSearchPanel)headerSearchPanel.hidden=open;headerSearchTrigger.setAttribute('aria-expanded',String(!open))});
</script>
<script>
const cards=[...document.querySelectorAll<HTMLElement>('.product-card')],buttons=[...document.querySelectorAll<HTMLElement>('.category-option')],tabs=[...document.querySelectorAll<HTMLElement>('.tab')],search=document.querySelector<HTMLInputElement>('.search'),grid=document.querySelector<HTMLElement>('#product-grid'),label=document.querySelector<HTMLElement>('#collection-label');let activeCategory='All',activeKind='';const filter=()=>{const q=(search?.value||'').toLowerCase();cards.forEach(card=>{card.hidden=!((activeCategory==='All'||card.dataset.category===activeCategory)&&(!activeKind||card.dataset.kind===activeKind)&&(!q||card.dataset.search?.includes(q)))})};const setCategory=(category:string)=>{activeCategory=category;activeKind='';buttons.forEach(button=>{const selected=button.dataset.category===category;button.classList.toggle('active',selected);button.setAttribute('aria-selected',String(selected))});tabs.forEach(tab=>tab.classList.toggle('active',tab.dataset.category===category));if(label)label.textContent=category==='All'?'All products':category;filter()};const categoryPanel=document.querySelector<HTMLElement>('#category-panel'),searchPanel=document.querySelector<HTMLElement>('#search-panel'),categoryTrigger=document.querySelector<HTMLElement>('.category-trigger'),searchTrigger=document.querySelector<HTMLElement>('.search-trigger');const closePanels=()=>{if(categoryPanel)categoryPanel.hidden=true;if(searchPanel)searchPanel.hidden=true;categoryTrigger?.setAttribute('aria-expanded','false');searchTrigger?.setAttribute('aria-expanded','false')};const initialCategory=new URLSearchParams(location.search).get('category');const initialButton=buttons.find(button=>button.dataset.category?.toLowerCase()===initialCategory);setCategory(initialButton?.dataset.category||'All');buttons.forEach(button=>button.addEventListener('click',()=>{setCategory(button.dataset.category||'All');closePanels()}));tabs.forEach(tab=>tab.addEventListener('click',()=>{activeKind=tab.dataset.kind||'';if(tab.dataset.category)setCategory(tab.dataset.category);tabs.forEach(item=>item.classList.toggle('active',item===tab));filter()}));search?.addEventListener('input',filter);categoryTrigger?.addEventListener('click',()=>{const open=categoryPanel?.hidden===false;closePanels();if(categoryPanel)categoryPanel.hidden=open;categoryTrigger?.setAttribute('aria-expanded',String(!open))});searchTrigger?.addEventListener('click',()=>{const open=searchPanel?.hidden===false;closePanels();if(searchPanel)searchPanel.hidden=open;searchTrigger?.setAttribute('aria-expanded',String(!open))});const viewMenu=document.querySelector<HTMLElement>('.view-menu');document.querySelector('.view-button')?.addEventListener('click',()=>{if(viewMenu)viewMenu.hidden=!viewMenu.hidden});viewMenu?.querySelectorAll<HTMLElement>('button').forEach(button=>button.addEventListener('click',()=>{grid?.classList.remove('view-large','view-list');if(button.dataset.view==='large')grid?.classList.add('view-large');if(button.dataset.view==='list')grid?.classList.add('view-list');viewMenu.hidden=true}));const modal=document.querySelector<HTMLElement>('#contact-modal');const closeModal=()=>{if(modal)modal.hidden=true};document.querySelector('.contact-trigger')?.addEventListener('click',()=>{if(modal)modal.hidden=false});document.querySelector('.modal-close')?.addEventListener('click',closeModal);document.querySelector('.modal-backdrop')?.addEventListener('click',closeModal);document.addEventListener('keydown',event=>{if(event.key==='Escape')closeModal()});
const searchResults=document.querySelector<HTMLElement>('#search-results');let searchTimer=0;const renderSearchResults=(results:any[],query:string)=>{if(!searchResults)return;searchResults.innerHTML='';if(!query){searchResults.hidden=true;return}if(!results.length){searchResults.innerHTML='<div class="search-empty">No matching works</div>';searchResults.hidden=false;return}results.forEach(result=>{const link=document.createElement('a');link.className='search-result';link.href=`/products/${result.slug}/`;link.setAttribute('role','option');link.innerHTML=`<img src="${result.cover}" alt="" loading="lazy" /><span><strong>${result.titleZh||result.title}</strong><em>${result.category} · ${result.title}</em></span>`;searchResults.appendChild(link)});searchResults.hidden=false};const fetchSuggestions=async(query:string)=>{if(!query){renderSearchResults([],query);return}try{const response=await fetch(`/api/search?q=${encodeURIComponent(query)}`);const data=await response.json();renderSearchResults(data.results||[],query)}catch{renderSearchResults([],query)}};search?.addEventListener('input',()=>{filter();window.clearTimeout(searchTimer);const query=search.value.trim();searchTimer=window.setTimeout(()=>fetchSuggestions(query),180)});</script>




