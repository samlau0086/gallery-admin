---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { site } from '../data/site';
import '../styles/global.css';
import '../styles/overrides.css';
export const prerender = true;
const products = (await getCollection('products', ({ data }) => data.published)).sort((a,b) => a.data.sortOrder - b.data.sortOrder);
const initialProducts = products.slice(0, 24);
const normalizeCopy = (value = '') => value.toLowerCase().replace(/[\s\p{P}\p{S}]+/gu, '');
const displayDescription = (title = '', titleZh = '', description = '') => {
  const copy = description.trim();
  if (!copy) return '';
  const normalized = normalizeCopy(copy);
  return [title, titleZh].some(candidate => candidate && normalizeCopy(candidate) === normalized) ? '' : copy;
};
const deferredProducts = products.slice(24).map(({ slug, data }) => ({
  slug,
  title: data.title,
  titleZh: data.titleZh ?? '',
  category: data.category,
  brand: data.brand ?? '',
  featured: data.featured,
  cover: data.cover,
  description: displayDescription(data.title, data.titleZh, data.description),
  tags: data.tags,
  sku: data.sku ?? ''
}));
const catalogFilters = products.map(({ slug, data }) => ({
  slug,
  brand: data.brand ?? '',
  tags: data.tags,
  title: data.title,
  titleZh: data.titleZh ?? '',
  category: data.category,
  featured: Boolean(data.featured),
  cover: data.cover,
  description: displayDescription(data.title, data.titleZh, data.description),
  sku: data.sku ?? '',
}));
---
<Layout title={site.name} description={site.tagline}>
<div class="app-shell">
<main class="content-column"><section class="collection-head"><div class="tabs"><button class="tab active" type="button" data-category="All">All</button><button class="tab" type="button" data-kind="new">New</button><button class="tab" type="button" data-kind="video">Video</button><button class="tab" type="button" data-kind="photos">Photos</button></div><div class="view-controls"><span class="collection-count">{products.length} works</span><button class="view-button" type="button" aria-label="Change grid view">▦</button><div class="view-menu" hidden><button type="button" data-view="grid">▦ Gallery</button><button type="button" data-view="large">▤ Large image</button><button type="button" data-view="list">☷ List view</button></div></div></section><section class="product-grid" id="product-grid">{initialProducts.map((product, index) => <a class="product-card" data-category={product.data.category} data-kind={product.data.featured ? 'new' : 'photos'} data-search={(product.data.title+' '+(product.data.titleZh??'')+' '+product.data.tags.join(' ')).toLowerCase()} href={'/products/'+product.slug+'/'}><div class="image-frame"><img src={product.data.cover} alt={product.data.title} width="1200" height="1600" loading={index === 0 ? 'eager' : 'lazy'} fetchpriority={index === 0 ? 'high' : 'auto'} decoding="async"/><span class="share-mark">↗</span></div><div class="product-copy"><strong>{product.data.titleZh ?? product.data.title}</strong><span>{product.data.title}</span><p>{product.data.description}</p></div><button class="basket-card-button" type="button" data-add-to-basket data-product-id={product.slug} data-product-title={product.data.title} data-product-sku={product.data.sku??''} data-product-image={product.data.cover} data-product-url={'/products/'+product.slug+'/'}><img src="/cart.svg" alt="" />Add to basket</button></a>)}</section><div id="load-more-sentinel" aria-hidden="true"></div><p class="load-more-status" id="load-more-status" aria-live="polite"></p><script type="application/json" id="deferred-products" set:html={JSON.stringify(deferredProducts)}></script></main>
<button class="export-button" id="export-pdf" type="button" aria-label="Export filtered products as PDF" title="Export filtered products as PDF"><img src="/download-svgrepo-com.svg" alt="" /><span>PDF</span></button><a class="help-button" href="https://wa.me/85265426672" aria-label="WhatsApp" title="WhatsApp">◉</a>
</div>
<div class="contact-modal" id="contact-modal" hidden><div class="modal-backdrop"></div><section class="modal-card" role="dialog" aria-modal="true" aria-labelledby="contact-title"><button class="modal-close" type="button" aria-label="Close">×</button><span class="eyebrow">Get in touch</span><h2 id="contact-title">Contact us</h2><p>We would be happy to help with product details, sourcing and appointments.</p><div class="contact-links"><a href="https://wa.me/85265426672">WhatsApp</a><a href="mailto:info@maesvanti.online">info@maesvanti.online</a></div></section></div>
<div class="export-modal" id="export-modal" hidden><div class="modal-backdrop"></div><section class="modal-card export-progress-card" role="dialog" aria-modal="true" aria-labelledby="export-modal-title"><span class="eyebrow">PDF export</span><h2 id="export-modal-title">Preparing PDF</h2><p id="export-modal-status" role="status" aria-live="polite">Starting…</p><div class="export-progress-track"><span id="export-progress-bar"></span></div><div class="export-modal-actions"><button class="export-cancel" id="export-cancel" type="button">Cancel</button><button class="export-save" id="export-save" type="button" hidden>Save PDF</button></div></section></div>
</Layout>
<script type="application/json" id="catalog-filters" set:html={JSON.stringify(catalogFilters)}></script>
<script is:inline src="/catalog-filter.js"></script>
<script src="/deduplicate.js" defer></script>
<script>
type CatalogProduct={slug:string;title:string;titleZh?:string;category?:string;brand?:string;tags?:string[];sku?:string;cover:string};
declare global { interface Window { jspdf?: { jsPDF: any } } }
const exportButton=document.querySelector<HTMLButtonElement>('#export-pdf'),exportDataNode=document.querySelector<HTMLScriptElement>('#catalog-filters');
const controls=document.querySelector('.view-controls'); if(exportButton&&controls) controls.insertBefore(exportButton,controls.querySelector('.view-button'));
const imageUrl=(url='')=>url.startsWith('https://xcimg.szwego.com/')?`/api/export-image?url=${encodeURIComponent(url)}`:url;
const loadImage=async(url:string)=>new Promise<HTMLImageElement>((resolve,reject)=>{const image=new Image();image.onload=()=>resolve(image);image.onerror=reject;image.src=imageUrl(url)});
const imageData=async(url:string)=>{const image=await loadImage(url),canvas=document.createElement('canvas'),ratio=Math.min(480/Math.max(image.naturalWidth,1),480/Math.max(image.naturalHeight,1),1);canvas.width=Math.max(1,Math.round(image.naturalWidth*ratio));canvas.height=Math.max(1,Math.round(image.naturalHeight*ratio));canvas.getContext('2d')?.drawImage(image,0,0,canvas.width,canvas.height);return { data:canvas.toDataURL('image/jpeg',.72),width:canvas.width,height:canvas.height }};
const getJsPdf=async()=>{if(window.jspdf?.jsPDF)return window.jspdf.jsPDF;await new Promise<void>((resolve,reject)=>{const script=document.createElement('script');script.src='/jspdf.umd.min.js';script.onload=()=>resolve();script.onerror=()=>reject(new Error('Unable to load PDF library.'));document.head.appendChild(script)});if(!window.jspdf?.jsPDF)throw new Error('PDF library unavailable.');return window.jspdf.jsPDF};
const exportModal=document.querySelector<HTMLElement>('#export-modal'),exportStatus=document.querySelector<HTMLElement>('#export-modal-status'),exportBar=document.querySelector<HTMLElement>('#export-progress-bar'),exportCancel=document.querySelector<HTMLButtonElement>('#export-cancel'),exportSave=document.querySelector<HTMLButtonElement>('#export-save');let exportCancelled=false,readyPdf:any=null,readyFilename='';
const resetExport=()=>{readyPdf=null;readyFilename='';exportCancelled=false;if(exportSave){exportSave.hidden=true;exportSave.disabled=false}if(exportCancel){exportCancel.hidden=false;exportCancel.disabled=false}if(exportBar)exportBar.style.width='0%'};
const closeExport=(keepCancelled=false)=>{if(exportModal)exportModal.hidden=true;resetExport();if(keepCancelled)exportCancelled=true;if(exportButton){exportButton.disabled=false;exportButton.classList.remove('is-exporting');const label=exportButton.querySelector<HTMLSpanElement>('span');if(label)label.textContent='PDF'}};
exportCancel?.addEventListener('click',()=>{closeExport(true)});
exportSave?.addEventListener('click',async()=>{if(!readyPdf)return;exportSave.disabled=true;if(exportStatus)exportStatus.textContent='Saving PDF…';try{await readyPdf.save(readyFilename,{returnPromise:true})}finally{closeExport()}});
exportButton?.addEventListener('click',async()=>{const all=JSON.parse(exportDataNode?.textContent||'[]') as CatalogProduct[],q=(document.querySelector<HTMLInputElement>('.search')?.value||'').trim().toLowerCase(),activeTab=document.querySelector<HTMLElement>('.tab.active[data-filter-mode]'),mode=activeTab?.dataset.filterMode||'all',selected=document.querySelector<HTMLElement>('.filter-options button.active')?.dataset.value||'',products=all.filter(p=>{const text=[p.title,p.titleZh,p.category,p.brand,p.sku,...(p.tags||[])].filter(Boolean).join(' ').toLowerCase(),matchesSelection=!selected||mode==='tags'?(mode!=='tags'||!selected||(p.tags||[]).includes(selected)):p.brand===selected;return matchesSelection&&(!q||text.includes(q))}),heading=selected?`${mode==='tags'?'Tag':'Brand'}: ${selected}`:'All products',label=exportButton.querySelector<HTMLSpanElement>('span');if(!products.length)return;resetExport();if(exportModal)exportModal.hidden=false;if(exportStatus)exportStatus.textContent=`Preparing ${products.length} products…`;exportButton.disabled=true;exportButton.classList.add('is-exporting');try{if(label)label.textContent='Loading…';const jsPDF=await getJsPdf();if(exportCancelled)return;const pdf=new jsPDF({orientation:'landscape',unit:'mm',format:'a4',compress:true}),pageWidth=pdf.internal.pageSize.getWidth(),pageHeight=pdf.internal.pageSize.getHeight(),margin=10,columns=6,rows=3,gap=4,cardWidth=(pageWidth-margin*2-gap*(columns-1))/columns,cardHeight=(pageHeight-margin*2-gap*(rows-1))/rows,imageHeight=cardHeight-10;pdf.setProperties({title:heading,subject:`${products.length} products`});for(let index=0;index<products.length;index++){if(exportCancelled)return;const product=products[index],slot=index%(columns*rows);if(index&&slot===0)pdf.addPage();const column=slot%columns,row=Math.floor(slot/columns),x=margin+column*(cardWidth+gap),y=margin+row*(cardHeight+gap);try{const image=await imageData(product.cover);if(exportCancelled)return;const scale=Math.min(cardWidth/image.width,imageHeight/image.height),width=image.width*scale,height=image.height*scale,imageX=x+(cardWidth-width)/2,imageY=y+(imageHeight-height)/2;pdf.addImage(image.data,'JPEG',imageX,imageY,width,height,undefined,'FAST');pdf.link(imageX,imageY,width,height,{url:`${location.origin}/products/${encodeURIComponent(product.slug)}/`})}catch{pdf.setDrawColor(220);pdf.rect(x,y,cardWidth,imageHeight)}pdf.setFontSize(7);pdf.setTextColor(55);pdf.text(product.sku||'',x+cardWidth/2,y+imageHeight+5,{align:'center',maxWidth:cardWidth});pdf.setTextColor(32);const progress=Math.round((index+1)/products.length*100);if(label)label.textContent=`${progress}%`;if(exportStatus)exportStatus.textContent=`Preparing ${index+1} of ${products.length} products`;if(exportBar)exportBar.style.width=`${progress}%`;await new Promise(resolve=>setTimeout(resolve,0))}readyPdf=pdf;readyFilename=`${heading.replace(/[^a-z0-9]+/gi,'-').replace(/^-|-$/g,'').toLowerCase()||'products'}-${new Date().toISOString().slice(0,10)}.pdf`;if(exportStatus)exportStatus.textContent=`PDF is ready: ${products.length} products.`;if(exportBar)exportBar.style.width='100%';if(exportCancel)exportCancel.hidden=true;if(exportSave)exportSave.hidden=false;if(label)label.textContent='Ready'}catch{if(exportStatus)exportStatus.textContent='Unable to prepare the PDF. Please try again.';if(label)label.textContent='Retry';if(exportCancel)exportCancel.textContent='Close'}finally{if(exportCancelled||!readyPdf){exportButton.disabled=false;exportButton.classList.remove('is-exporting');if(label&&label.textContent!=='Retry')label.textContent='PDF'}}});
</script>
<script is:inline>
document.addEventListener('input', (event) => {
  if (!(event.target instanceof HTMLInputElement) || !event.target.matches('input.search')) return;
  document.querySelectorAll('.product-card').forEach((card) => {
    const sku = card.querySelector('[data-product-sku]')?.getAttribute('data-product-sku') || '';
    if (sku && !card.dataset.search?.includes(sku.toLowerCase())) card.dataset.search = `${card.dataset.search || ''} ${sku}`.toLowerCase();
  });
}, true);
</script>
<script>
const contactCard=document.querySelector<HTMLElement>('#contact-modal .modal-card');if(contactCard){const intro=contactCard.querySelector('.contact-links');if(intro){intro.innerHTML='<form class="contact-form" id="contact-form"><label>Name<input name="name" required maxlength="100" autocomplete="name" /></label><label>Email<input name="email" type="email" required maxlength="200" autocomplete="email" /></label><label>WhatsApp (optional)<input name="whatsapp" maxlength="40" autocomplete="tel" /></label><label>Message<textarea name="message" required minlength="10" maxlength="4000" rows="5"></textarea></label><input class="contact-honeypot" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" /><p class="contact-status" id="contact-status" role="status" aria-live="polite"></p><button class="contact-submit" type="submit">Send message</button></form>';const form=document.querySelector<HTMLFormElement>('#contact-form'),status=document.querySelector<HTMLElement>('#contact-status');form?.addEventListener('submit',async event=>{event.preventDefault();const submit=form.querySelector<HTMLButtonElement>('button[type=submit]');if(!submit)return;submit.disabled=true;if(status)status.textContent='Sending…';try{const response=await fetch('/api/contact',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify(Object.fromEntries(new FormData(form)))});const data=await response.json();if(!response.ok)throw new Error(data.error||'Unable to send your message.');form.reset();if(status)status.textContent='Thanks — your message has been sent.'}catch(error){if(status)status.textContent=error instanceof Error?error.message:'Unable to send your message.'}finally{submit.disabled=false}})}}
</script>

<script is:inline>
const deferredNode=document.querySelector('#deferred-products');
const productGrid=document.querySelector('#product-grid');
const loadSentinel=document.querySelector('#load-more-sentinel');
let deferredProducts=JSON.parse(deferredNode?.textContent||'[]');
let allProductCards=[...document.querySelectorAll('.product-card')];
const categoryFromSlug=(slug='')=>{const option=[...document.querySelectorAll('.category-option')].find(item=>item.dataset.category?.toLowerCase().replace(/[^a-z0-9]+/g,'-')===slug.toLowerCase());return option?.dataset.category||'All'};
let activeListCategory=categoryFromSlug(new URLSearchParams(location.search).get('category')||'all'),activeListKind='';
const makeProductCard=(product)=>{const link=document.createElement('a');link.className='product-card';link.href=`/products/${product.slug}/`;link.dataset.category=product.category;link.dataset.kind=product.featured?'new':'photos';link.dataset.productTitle=product.title;link.dataset.productSku=product.sku||'';link.dataset.productImage=product.cover;link.dataset.search=`${product.title} ${product.titleZh||''} ${(product.tags||[]).join(' ')}`.toLowerCase();link.innerHTML=`<div class="image-frame"><img src="${product.cover}" alt="${product.title}" width="1200" height="1600" loading="lazy" decoding="async"><span class="share-mark">↗</span></div><div class="product-copy"><strong>${product.titleZh||product.title}</strong><span>${product.title}</span><div class="description-wrap"><p>${product.description||''}</p><button type="button" class="description-toggle" data-description-toggle>View more</button></div></div><button class="basket-card-button" type="button" data-add-to-basket data-product-id="${product.slug}" data-product-title="${product.title}" data-product-sku="${product.sku||''}" data-product-image="${product.cover}" data-product-url="/products/${product.slug}/"><img src="/cart.svg" alt="">Add to basket</button><button class="inquiry-card-button" type="button" data-inquiry-product><img src="/whatsapp-mark.svg" alt="">WhatsApp inquiry</button>`;return link};
const applyListFilter=()=>{const searchInput=document.querySelector('.search');const q=(searchInput?.value||'').toLowerCase();allProductCards.forEach(card=>{card.hidden=!((activeListCategory==='All'||card.dataset.category===activeListCategory)&&(!activeListKind||card.dataset.kind===activeListKind)&&(!q||card.dataset.search?.includes(q)))})};
applyListFilter();
const isSentinelVisible=()=>{if(!loadSentinel)return false;const rect=loadSentinel.getBoundingClientRect();return rect.top<=window.innerHeight+700&&rect.bottom>=-700};
const appendProducts=()=>{if(!productGrid||!deferredProducts.length)return;const batch=deferredProducts.splice(0,24);const fragment=document.createDocumentFragment();batch.forEach(product=>fragment.appendChild(makeProductCard(product)));productGrid.appendChild(fragment);allProductCards=[...document.querySelectorAll('.product-card')];applyListFilter();requestAnimationFrame(()=>{if(isSentinelVisible())appendProducts()})};
if(loadSentinel&&'IntersectionObserver' in window){const loadObserver=new IntersectionObserver(entries=>{if(entries.some(entry=>entry.isIntersecting))appendProducts()},{rootMargin:'700px'});loadObserver.observe(loadSentinel)}
document.querySelectorAll('.category-option').forEach(button=>button.addEventListener('click',()=>{activeListCategory=button.dataset.category||'All';activeListKind='';applyListFilter()}));
document.querySelectorAll('.tab').forEach(tab=>tab.addEventListener('click',()=>{activeListKind=tab.dataset.kind||'';if(tab.dataset.category)activeListCategory=tab.dataset.category;applyListFilter()}));
document.querySelector('.search')?.addEventListener('input',applyListFilter);
</script>
<script>
const headerCategoryPanel=document.querySelector<HTMLElement>('#global-category-panel');
const headerSearchPanel=document.querySelector<HTMLElement>('#global-search-panel');
const headerCategoryTrigger=document.querySelector<HTMLElement>('.category-trigger');
const headerSearchTrigger=document.querySelector<HTMLElement>('.search-trigger');
const closeHeaderPanels=()=>{if(headerCategoryPanel)headerCategoryPanel.hidden=true;if(headerSearchPanel)headerSearchPanel.hidden=true;headerCategoryTrigger?.setAttribute('aria-expanded','false');headerSearchTrigger?.setAttribute('aria-expanded','false')};
headerCategoryTrigger?.addEventListener('click',()=>{const open=headerCategoryPanel?.hidden===false;closeHeaderPanels();if(headerCategoryPanel)headerCategoryPanel.hidden=open;headerCategoryTrigger.setAttribute('aria-expanded',String(!open))});
headerSearchTrigger?.addEventListener('click',()=>{const open=headerSearchPanel?.hidden===false;closeHeaderPanels();if(headerSearchPanel)headerSearchPanel.hidden=open;headerSearchTrigger.setAttribute('aria-expanded',String(!open))});
</script>
<script>
const cards=[...document.querySelectorAll<HTMLElement>('.product-card')],buttons=[...document.querySelectorAll<HTMLElement>('.category-option')],tabs=[...document.querySelectorAll<HTMLElement>('.tab')],search=document.querySelector<HTMLInputElement>('.search'),grid=document.querySelector<HTMLElement>('#product-grid');let activeCategory='All',activeKind='';const filter=()=>{const q=(search?.value||'').toLowerCase();cards.forEach(card=>{card.hidden=!((activeCategory==='All'||card.dataset.category===activeCategory)&&(!activeKind||card.dataset.kind===activeKind)&&(!q||card.dataset.search?.includes(q)))})};const setCategory=(category:string)=>{activeCategory=category;activeKind='';buttons.forEach(button=>{const selected=button.dataset.category===category;button.classList.toggle('active',selected);button.setAttribute('aria-selected',String(selected))});tabs.forEach(tab=>tab.classList.toggle('active',tab.dataset.category===category));filter()};const categoryPanel=document.querySelector<HTMLElement>('#category-panel'),searchPanel=document.querySelector<HTMLElement>('#search-panel'),categoryTrigger=document.querySelector<HTMLElement>('.category-trigger'),searchTrigger=document.querySelector<HTMLElement>('.search-trigger');const closePanels=()=>{if(categoryPanel)categoryPanel.hidden=true;if(searchPanel)searchPanel.hidden=true;categoryTrigger?.setAttribute('aria-expanded','false');searchTrigger?.setAttribute('aria-expanded','false')};const initialCategory=new URLSearchParams(location.search).get('category');const initialButton=buttons.find(button=>button.dataset.category?.toLowerCase()===initialCategory);setCategory(initialButton?.dataset.category||'All');buttons.forEach(button=>button.addEventListener('click',()=>{setCategory(button.dataset.category||'All');closePanels()}));tabs.forEach(tab=>tab.addEventListener('click',()=>{activeKind=tab.dataset.kind||'';if(tab.dataset.category)setCategory(tab.dataset.category);tabs.forEach(item=>item.classList.toggle('active',item===tab));filter()}));search?.addEventListener('input',filter);categoryTrigger?.addEventListener('click',()=>{const open=categoryPanel?.hidden===false;closePanels();if(categoryPanel)categoryPanel.hidden=open;categoryTrigger?.setAttribute('aria-expanded',String(!open))});searchTrigger?.addEventListener('click',()=>{const open=searchPanel?.hidden===false;closePanels();if(searchPanel)searchPanel.hidden=open;searchTrigger?.setAttribute('aria-expanded',String(!open))});const viewMenu=document.querySelector<HTMLElement>('.view-menu');document.querySelector('.view-button')?.addEventListener('click',()=>{if(viewMenu)viewMenu.hidden=!viewMenu.hidden});viewMenu?.querySelectorAll<HTMLElement>('button').forEach(button=>button.addEventListener('click',()=>{grid?.classList.remove('view-large','view-list');if(button.dataset.view==='large')grid?.classList.add('view-large');if(button.dataset.view==='list')grid?.classList.add('view-list');viewMenu.hidden=true}));const modal=document.querySelector<HTMLElement>('#contact-modal');const closeModal=()=>{if(modal)modal.hidden=true};document.querySelector('.contact-trigger')?.addEventListener('click',()=>{if(modal)modal.hidden=false});document.querySelector('.modal-close')?.addEventListener('click',closeModal);document.querySelector('.modal-backdrop')?.addEventListener('click',closeModal);document.addEventListener('keydown',event=>{if(event.key==='Escape')closeModal()});
const searchResults=document.querySelector<HTMLElement>('#search-results');let searchTimer=0;const renderSearchResults=(results:any[],query:string)=>{if(!searchResults)return;searchResults.innerHTML='';if(!query){searchResults.hidden=true;return}if(!results.length){searchResults.innerHTML='<div class="search-empty">No matching works</div>';searchResults.hidden=false;return}results.forEach(result=>{const link=document.createElement('a');link.className='search-result';link.href=`/products/${result.slug}/`;link.setAttribute('role','option');link.innerHTML=`<img src="${result.cover}" alt="" loading="lazy" /><span><strong>${result.titleZh||result.title}</strong><em>${result.category} · ${result.title}</em></span>`;searchResults.appendChild(link)});searchResults.hidden=false};const fetchSuggestions=async(query:string)=>{if(!query){renderSearchResults([],query);return}try{const response=await fetch(`/api/search?q=${encodeURIComponent(query)}`);const data=await response.json();renderSearchResults(data.results||[],query)}catch{renderSearchResults([],query)}};search?.addEventListener('input',()=>{filter();window.clearTimeout(searchTimer);const query=search.value.trim();searchTimer=window.setTimeout(()=>fetchSuggestions(query),180)});</script>






