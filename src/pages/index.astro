---
import Layout from '../layouts/Layout.astro';
import { site } from '../data/site';
import '../styles/global.css';
import '../styles/overrides.css';
export const prerender = true;
---
<Layout title={site.name} description={site.tagline}>
<div class="app-shell">
<main class="content-column"><section class="collection-head"><div class="tabs"><button class="tab active" type="button" data-category="All">All</button><button class="tab" type="button" data-kind="new">New</button><button class="tab" type="button" data-kind="video">Video</button><button class="tab" type="button" data-kind="photos">Photos</button></div><div class="view-controls"><span class="collection-count">Loading collection</span><button class="view-button" type="button" aria-label="Change grid view">▦</button><div class="view-menu" hidden><button type="button" data-view="grid">▦ Gallery</button><button type="button" data-view="large">▤ Large image</button><button type="button" data-view="list">☷ List view</button></div></div></section><section class="product-grid is-loading" id="product-grid" aria-busy="true">{Array.from({ length: 12 }, (_, index) => <div class="product-skeleton" aria-hidden="true" key={index}><div class="skeleton-image"></div><div class="skeleton-line skeleton-title"></div><div class="skeleton-line skeleton-subtitle"></div><div class="skeleton-line skeleton-description"></div></div>)}</section><div id="load-more-sentinel" aria-hidden="true"></div><p class="load-more-status" id="load-more-status" aria-live="polite"></p></main>
<button class="export-button" id="export-pdf" type="button" aria-label="Export filtered products as PDF" title="Export filtered products as PDF"><img src="/download-svgrepo-com.svg" alt="" /><span>PDF</span></button>
</div>
<div class="contact-modal" id="contact-modal" hidden><div class="modal-backdrop"></div><section class="modal-card" role="dialog" aria-modal="true" aria-labelledby="contact-title"><button class="modal-close" type="button" aria-label="Close">×</button><span class="eyebrow">Get in touch</span><h2 id="contact-title">Contact us</h2><p>We would be happy to help with product details, sourcing and appointments.</p><div class="contact-links"><a href="https://wa.me/85265426672">WhatsApp</a><a href="mailto:info@maesvanti.online">info@maesvanti.online</a></div></section></div>
<div class="export-modal" id="export-modal" hidden><div class="modal-backdrop"></div><section class="modal-card export-progress-card" role="dialog" aria-modal="true" aria-labelledby="export-modal-title"><span class="eyebrow">PDF export</span><h2 id="export-modal-title">Preparing PDF</h2><p id="export-modal-status" role="status" aria-live="polite">Starting…</p><div class="export-progress-track"><span id="export-progress-bar"></span></div><div class="export-modal-actions"><button class="export-cancel" id="export-cancel" type="button">Cancel</button><button class="export-save" id="export-save" type="button" hidden>Save PDF</button></div></section></div>
</Layout>
<script src="/deduplicate.js" defer></script>
<script>
type CatalogProduct={slug:string;title:string;titleZh?:string;category?:string;brand?:string;tags?:string[];sku?:string;cover:string};
declare global { interface Window { jspdf?: { jsPDF: any }; __catalogProducts?: CatalogProduct[]; __catalogSearchTimer?: number } }
const exportButton=document.querySelector<HTMLButtonElement>('#export-pdf');
const controls=document.querySelector('.view-controls'); if(exportButton&&controls) controls.insertBefore(exportButton,controls.querySelector('.view-button'));
const imageUrl=(url='')=>url.startsWith('https://xcimg.szwego.com/')?`/api/export-image?url=${encodeURIComponent(url)}`:url;
const loadImage=async(url:string)=>new Promise<HTMLImageElement>((resolve,reject)=>{const image=new Image();image.onload=()=>resolve(image);image.onerror=reject;image.src=imageUrl(url)});
const imageData=async(url:string)=>{const image=await loadImage(url),canvas=document.createElement('canvas'),ratio=Math.min(480/Math.max(image.naturalWidth,1),480/Math.max(image.naturalHeight,1),1);canvas.width=Math.max(1,Math.round(image.naturalWidth*ratio));canvas.height=Math.max(1,Math.round(image.naturalHeight*ratio));canvas.getContext('2d')?.drawImage(image,0,0,canvas.width,canvas.height);return { data:canvas.toDataURL('image/jpeg',.72),width:canvas.width,height:canvas.height }};
const getJsPdf=async()=>{if(window.jspdf?.jsPDF)return window.jspdf.jsPDF;await new Promise<void>((resolve,reject)=>{const script=document.createElement('script');script.src='/jspdf.umd.min.js';script.onload=()=>resolve();script.onerror=()=>reject(new Error('Unable to load PDF library.'));document.head.appendChild(script)});if(!window.jspdf?.jsPDF)throw new Error('PDF library unavailable.');return window.jspdf.jsPDF};
const exportModal=document.querySelector<HTMLElement>('#export-modal'),exportStatus=document.querySelector<HTMLElement>('#export-modal-status'),exportBar=document.querySelector<HTMLElement>('#export-progress-bar'),exportCancel=document.querySelector<HTMLButtonElement>('#export-cancel'),exportSave=document.querySelector<HTMLButtonElement>('#export-save');let exportCancelled=false,readyPdf:any=null,readyFilename='';
const resetExport=()=>{readyPdf=null;readyFilename='';exportCancelled=false;if(exportSave){exportSave.hidden=true;exportSave.disabled=false}if(exportCancel){exportCancel.hidden=false;exportCancel.disabled=false}if(exportBar)exportBar.style.width='0%'};
const closeExport=(keepCancelled=false)=>{if(exportModal)exportModal.hidden=true;resetExport();if(keepCancelled)exportCancelled=true;if(exportButton){exportButton.disabled=false;exportButton.classList.remove('is-exporting');const label=exportButton.querySelector<HTMLSpanElement>('span');if(label)label.textContent='PDF'}};
exportCancel?.addEventListener('click',()=>{closeExport(true)});
exportSave?.addEventListener('click',async()=>{if(!readyPdf)return;exportSave.disabled=true;if(exportStatus)exportStatus.textContent='Saving PDF…';try{await readyPdf.save(readyFilename,{returnPromise:true})}finally{closeExport()}});
exportButton?.addEventListener('click',async()=>{const all=await loadAllProducts() as CatalogProduct[],q=(document.querySelector<HTMLInputElement>('.search')?.value||'').trim().toLowerCase(),activeTab=document.querySelector<HTMLElement>('.tab.active[data-filter-mode]'),mode=activeTab?.dataset.filterMode||'all',selected=document.querySelector<HTMLElement>('.filter-options button.active')?.dataset.value||'',products=all.filter(p=>{const text=[p.title,p.titleZh,p.category,p.brand,p.sku,...(p.tags||[])].filter(Boolean).join(' ').toLowerCase(),matchesSelection=!selected||mode==='tags'?(mode!=='tags'||!selected||(p.tags||[]).includes(selected)):p.brand===selected;return matchesSelection&&(!q||text.includes(q))}),heading=selected?`${mode==='tags'?'Tag':'Brand'}: ${selected}`:'All products',label=exportButton.querySelector<HTMLSpanElement>('span');if(!products.length)return;resetExport();if(exportModal)exportModal.hidden=false;if(exportStatus)exportStatus.textContent=`Preparing ${products.length} products…`;exportButton.disabled=true;exportButton.classList.add('is-exporting');try{if(label)label.textContent='Loading…';const jsPDF=await getJsPdf();if(exportCancelled)return;const pdf=new jsPDF({orientation:'landscape',unit:'mm',format:'a4',compress:true}),pageWidth=pdf.internal.pageSize.getWidth(),pageHeight=pdf.internal.pageSize.getHeight(),margin=10,columns=6,rows=3,gap=4,cardWidth=(pageWidth-margin*2-gap*(columns-1))/columns,cardHeight=(pageHeight-margin*2-gap*(rows-1))/rows,imageHeight=cardHeight-10;pdf.setProperties({title:heading,subject:`${products.length} products`});for(let index=0;index<products.length;index++){if(exportCancelled)return;const product=products[index],slot=index%(columns*rows);if(index&&slot===0)pdf.addPage();const column=slot%columns,row=Math.floor(slot/columns),x=margin+column*(cardWidth+gap),y=margin+row*(cardHeight+gap);try{const image=await imageData(product.cover);if(exportCancelled)return;const scale=Math.min(cardWidth/image.width,imageHeight/image.height),width=image.width*scale,height=image.height*scale,imageX=x+(cardWidth-width)/2,imageY=y+(imageHeight-height)/2;pdf.addImage(image.data,'JPEG',imageX,imageY,width,height,undefined,'FAST');pdf.link(imageX,imageY,width,height,{url:`${location.origin}/products/${encodeURIComponent(product.slug)}/`})}catch{pdf.setDrawColor(220);pdf.rect(x,y,cardWidth,imageHeight)}pdf.setFontSize(7);pdf.setTextColor(55);pdf.text(product.sku||'',x+cardWidth/2,y+imageHeight+5,{align:'center',maxWidth:cardWidth});pdf.setTextColor(32);const progress=Math.round((index+1)/products.length*100);if(label)label.textContent=`${progress}%`;if(exportStatus)exportStatus.textContent=`Preparing ${index+1} of ${products.length} products`;if(exportBar)exportBar.style.width=`${progress}%`;await new Promise(resolve=>setTimeout(resolve,0))}readyPdf=pdf;readyFilename=`${heading.replace(/[^a-z0-9]+/gi,'-').replace(/^-|-$/g,'').toLowerCase()||'products'}-${new Date().toISOString().slice(0,10)}.pdf`;if(exportStatus)exportStatus.textContent=`PDF is ready: ${products.length} products.`;if(exportBar)exportBar.style.width='100%';if(exportCancel)exportCancel.hidden=true;if(exportSave)exportSave.hidden=false;if(label)label.textContent='Ready'}catch{if(exportStatus)exportStatus.textContent='Unable to prepare the PDF. Please try again.';if(label)label.textContent='Retry';if(exportCancel)exportCancel.textContent='Close'}finally{if(exportCancelled||!readyPdf){exportButton.disabled=false;exportButton.classList.remove('is-exporting');if(label&&label.textContent!=='Retry')label.textContent='PDF'}}});
</script>
<script is:inline>
const productGrid=document.querySelector('#product-grid');
const loadSentinel=document.querySelector('#load-more-sentinel');
const loadStatus=document.querySelector('#load-more-status');
const collectionCount=document.querySelector('.collection-count');
let page=1,loading=false,hasMore=true,activeListCategory='',activeListKind='',activeListQuery='';
const productCache=[];
const loadAllProducts=async()=>{const products=[];let currentPage=1,more=true;while(more){const response=await fetch(`/api/products?page=${currentPage}&pageSize=48`);if(!response.ok)throw new Error('Unable to load products');const data=await response.json();products.push(...data.products);more=Boolean(data.hasMore);currentPage+=1}return products};
const renderProductCard=(product)=>{const link=document.createElement('a');link.className='product-card';link.href=`/products/${product.slug}/`;link.dataset.category=product.category||'';link.dataset.kind=product.featured?'new':'photos';link.dataset.productTitle=product.title||'';link.dataset.productSku=product.sku||'';link.dataset.productImage=product.cover||'';link.dataset.productId=product.slug;link.dataset.search=product.searchable||'';link.innerHTML=`<div class="image-frame"><img src="${product.cover||'/product-placeholder.svg'}" alt="${product.title||''}" width="1200" height="1600" loading="lazy" decoding="async"><span class="share-mark">↗</span></div><div class="product-copy"><strong>${product.titleZh||product.title||''}</strong><span>${product.title||''}</span><div class="description-wrap"><p>${product.description||''}</p><button type="button" class="description-toggle" data-description-toggle>View more</button></div></div><button class="basket-card-button" type="button" data-add-to-basket data-product-id="${product.slug}" data-product-title="${product.title||''}" data-product-sku="${product.sku||''}" data-product-image="${product.cover||''}" data-product-url="/products/${product.slug}/"><img src="/cart.svg" alt="">Add to basket</button><button class="inquiry-card-button" type="button" data-inquiry-product><img src="/whatsapp-mark.svg" alt="">WhatsApp inquiry</button>`;return link};
const appendProducts=async()=>{if(!productGrid||loading||!hasMore)return;loading=true;if(loadStatus)loadStatus.textContent='Loading products…';try{const params=new URLSearchParams({page:String(page),pageSize:'24'});if(activeListCategory)params.set('category',activeListCategory);if(activeListKind)params.set('kind',activeListKind);if(activeListQuery)params.set('q',activeListQuery);const response=await fetch(`/api/products?${params}`);if(!response.ok)throw new Error('Request failed');const data=await response.json();if(page===1){productGrid.innerHTML='';productGrid.classList.remove('is-loading')}if(collectionCount)collectionCount.textContent=data.total+' works';data.products.forEach((product)=>{productCache.push(product);productGrid.appendChild(renderProductCard(product))});page+=1;hasMore=Boolean(data.hasMore);productGrid.setAttribute('aria-busy','false');if(loadStatus)loadStatus.textContent=hasMore?'':'All products loaded'}catch{if(loadStatus)loadStatus.innerHTML='<button type="button" class="load-more-retry">Unable to load products. Try again</button>'}finally{loading=false}};
const resetProducts=()=>{page=1;hasMore=true;productCache.length=0;if(productGrid){productGrid.innerHTML='';for(let index=0;index<12;index++){const skeleton=document.createElement('div');skeleton.className='product-skeleton';skeleton.setAttribute('aria-hidden','true');skeleton.innerHTML='<div class="skeleton-image"></div><div class="skeleton-line skeleton-title"></div><div class="skeleton-line skeleton-subtitle"></div><div class="skeleton-line skeleton-description"></div>';productGrid.appendChild(skeleton)}productGrid.classList.add('is-loading');productGrid.setAttribute('aria-busy','true')}appendProducts()};
loadSentinel&&new IntersectionObserver((entries)=>{if(entries.some((entry)=>entry.isIntersecting))appendProducts()},{rootMargin:'700px'}).observe(loadSentinel);document.addEventListener('click',(event)=>{if(event.target.closest('.load-more-retry'))appendProducts()});
document.querySelectorAll('.tab').forEach((tab)=>tab.addEventListener('click',()=>{activeListCategory=tab.dataset.category&&tab.dataset.category!=='All'?tab.dataset.category:'';activeListKind=tab.dataset.kind||'';resetProducts()}));document.querySelectorAll('.category-option').forEach((button)=>button.addEventListener('click',()=>{activeListCategory=button.dataset.category&&button.dataset.category!=='All'?button.dataset.category:'';activeListKind='';resetProducts()}));document.querySelector('.search')?.addEventListener('input',(event)=>{activeListQuery=event.target.value.trim().toLowerCase();window.clearTimeout(window.__catalogSearchTimer);window.__catalogSearchTimer=window.setTimeout(resetProducts,220)});window.__catalogProducts=productCache;resetProducts();
</script><script>
const headerCategoryPanel=document.querySelector<HTMLElement>('#global-category-panel');
const headerSearchPanel=document.querySelector<HTMLElement>('#global-search-panel');
const headerCategoryTrigger=document.querySelector<HTMLElement>('.category-trigger');
const headerSearchTrigger=document.querySelector<HTMLElement>('.search-trigger');
const closeHeaderPanels=()=>{if(headerCategoryPanel)headerCategoryPanel.hidden=true;if(headerSearchPanel)headerSearchPanel.hidden=true;headerCategoryTrigger?.setAttribute('aria-expanded','false');headerSearchTrigger?.setAttribute('aria-expanded','false')};
headerCategoryTrigger?.addEventListener('click',()=>{const open=headerCategoryPanel?.hidden===false;closeHeaderPanels();if(headerCategoryPanel)headerCategoryPanel.hidden=open;headerCategoryTrigger.setAttribute('aria-expanded',String(!open))});
headerSearchTrigger?.addEventListener('click',()=>{const open=headerSearchPanel?.hidden===false;closeHeaderPanels();if(headerSearchPanel)headerSearchPanel.hidden=open;headerSearchTrigger.setAttribute('aria-expanded',String(!open))});
</script>
<script>
const cards=[...document.querySelectorAll<HTMLElement>('.product-card')],buttons=[...document.querySelectorAll<HTMLElement>('.category-option')],tabs=[...document.querySelectorAll<HTMLElement>('.tab')],search=document.querySelector<HTMLInputElement>('.search'),grid=document.querySelector<HTMLElement>('#product-grid');let activeCategory='All',activeKind='';const filter=()=>{const q=(search?.value||'').toLowerCase();cards.forEach(card=>{card.hidden=!((activeCategory==='All'||card.dataset.category===activeCategory)&&(!activeKind||card.dataset.kind===activeKind)&&(!q||card.dataset.search?.includes(q)))})};const setCategory=(category:string)=>{activeCategory=category;activeKind='';buttons.forEach(button=>{const selected=button.dataset.category===category;button.classList.toggle('active',selected);button.setAttribute('aria-selected',String(selected))});tabs.forEach(tab=>tab.classList.toggle('active',tab.dataset.category===category));filter()};const categoryPanel=document.querySelector<HTMLElement>('#category-panel'),searchPanel=document.querySelector<HTMLElement>('#search-panel'),categoryTrigger=document.querySelector<HTMLElement>('.category-trigger'),searchTrigger=document.querySelector<HTMLElement>('.search-trigger');const closePanels=()=>{if(categoryPanel)categoryPanel.hidden=true;if(searchPanel)searchPanel.hidden=true;categoryTrigger?.setAttribute('aria-expanded','false');searchTrigger?.setAttribute('aria-expanded','false')};const initialCategory=new URLSearchParams(location.search).get('category');const initialButton=buttons.find(button=>button.dataset.category?.toLowerCase()===initialCategory);setCategory(initialButton?.dataset.category||'All');buttons.forEach(button=>button.addEventListener('click',()=>{setCategory(button.dataset.category||'All');closePanels()}));tabs.forEach(tab=>tab.addEventListener('click',()=>{activeKind=tab.dataset.kind||'';if(tab.dataset.category)setCategory(tab.dataset.category);tabs.forEach(item=>item.classList.toggle('active',item===tab));filter()}));search?.addEventListener('input',filter);categoryTrigger?.addEventListener('click',()=>{const open=categoryPanel?.hidden===false;closePanels();if(categoryPanel)categoryPanel.hidden=open;categoryTrigger?.setAttribute('aria-expanded',String(!open))});searchTrigger?.addEventListener('click',()=>{const open=searchPanel?.hidden===false;closePanels();if(searchPanel)searchPanel.hidden=open;searchTrigger?.setAttribute('aria-expanded',String(!open))});const viewMenu=document.querySelector<HTMLElement>('.view-menu');document.querySelector('.view-button')?.addEventListener('click',()=>{if(viewMenu)viewMenu.hidden=!viewMenu.hidden});viewMenu?.querySelectorAll<HTMLElement>('button').forEach(button=>button.addEventListener('click',()=>{grid?.classList.remove('view-large','view-list');if(button.dataset.view==='large')grid?.classList.add('view-large');if(button.dataset.view==='list')grid?.classList.add('view-list');viewMenu.hidden=true}));const modal=document.querySelector<HTMLElement>('#contact-modal');const closeModal=()=>{if(modal)modal.hidden=true};document.querySelector('.contact-trigger')?.addEventListener('click',()=>{if(modal)modal.hidden=false});document.querySelector('.modal-close')?.addEventListener('click',closeModal);document.querySelector('.modal-backdrop')?.addEventListener('click',closeModal);document.addEventListener('keydown',event=>{if(event.key==='Escape')closeModal()});
const searchResults=document.querySelector<HTMLElement>('#search-results');let searchTimer=0;const renderSearchResults=(results:any[],query:string)=>{if(!searchResults)return;searchResults.innerHTML='';if(!query){searchResults.hidden=true;return}if(!results.length){searchResults.innerHTML='<div class="search-empty">No matching works</div>';searchResults.hidden=false;return}results.forEach(result=>{const link=document.createElement('a');link.className='search-result';link.href=`/products/${result.slug}/`;link.setAttribute('role','option');link.innerHTML=`<img src="${result.cover}" alt="" loading="lazy" /><span><strong>${result.titleZh||result.title}</strong><em>${result.category} · ${result.title}</em></span>`;searchResults.appendChild(link)});searchResults.hidden=false};const fetchSuggestions=async(query:string)=>{if(!query){renderSearchResults([],query);return}try{const response=await fetch(`/api/search?q=${encodeURIComponent(query)}`);const data=await response.json();renderSearchResults(data.results||[],query)}catch{renderSearchResults([],query)}};search?.addEventListener('input',()=>{filter();window.clearTimeout(searchTimer);const query=search.value.trim();searchTimer=window.setTimeout(()=>fetchSuggestions(query),180)});</script>





