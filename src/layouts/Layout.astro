---
const { title = 'Atelier Eleven', description = 'A considered collection of objects.' } = Astro.props;
import SiteHeader from '../components/SiteHeader.astro';
---
<!doctype html><html lang="en"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width" /><meta name="description" content={description} /><title>{title}</title></head><body><SiteHeader /><slot /><div class="inquiry-modal" id="inquiry-modal" hidden><div class="inquiry-backdrop" data-inquiry-close></div><section class="inquiry-dialog" role="dialog" aria-modal="true" aria-labelledby="inquiry-title"><button class="inquiry-close" type="button" aria-label="Close" data-inquiry-close>×</button><div class="inquiry-product"><img id="inquiry-image" src="" alt="" /><div><h2 id="inquiry-title"></h2><p id="inquiry-sku"></p></div></div><form id="inquiry-form" class="inquiry-form"><label>Quantity<div class="quantity-control"><button type="button" data-qty="-1" aria-label="Decrease quantity">−</button><input id="inquiry-quantity" name="quantity" type="number" min="1" max="999" value="1" /><button type="button" data-qty="1" aria-label="Increase quantity">+</button></div></label><label>Country<input id="inquiry-country" name="country" list="inquiry-countries" placeholder="Search country" required /><datalist id="inquiry-countries"><option>United States</option><option>United Kingdom</option><option>Canada</option><option>Australia</option><option>Germany</option><option>France</option><option>Italy</option><option>Spain</option><option>Singapore</option><option>Malaysia</option><option>Japan</option><option>South Korea</option><option>China</option><option>Hong Kong</option><option>Taiwan</option><option>India</option><option>Other</option></datalist></label><label>Message<textarea id="inquiry-message" name="message" rows="4" maxlength="1000" required></textarea><button class="inquiry-submit" type="submit">Send via WhatsApp</button></form></section></div><script>
  document.querySelectorAll<HTMLAnchorElement>('a[href^="https://wa.me/"], a[href^="mailto:"]').forEach((link) => {
    link.target = '_blank';
    link.rel = 'noopener noreferrer';
  });
</script><script is:inline>
const inquiryModal=document.querySelector('#inquiry-modal'); const inquiryForm=document.querySelector('#inquiry-form'); const inquiryCountry=document.querySelector('#inquiry-country'); const inquiryMessage=document.querySelector('#inquiry-message'); const inquiryQty=document.querySelector('#inquiry-quantity'); let inquiryProduct={title:'',sku:'',image:''};
document.querySelectorAll('.product-card').forEach(card=>{if(!card.dataset.productTitle)card.dataset.productTitle=card.querySelector('.product-copy strong')?.textContent?.trim()||'';if(!card.dataset.productImage)card.dataset.productImage=card.querySelector('img')?.getAttribute('src')||'';if(!card.dataset.productSku){const slug=card.getAttribute('href')?.match(/chanel-(\d+-\d+)/)?.[1];card.dataset.productSku=slug||card.dataset.productTitle||'';}if(!card.querySelector('[data-inquiry-product]')){const button=document.createElement('button');button.className='inquiry-card-button';button.type='button';button.dataset.inquiryProduct='';button.textContent='WhatsApp inquiry';card.appendChild(button);}});
const savedCountry=localStorage.getItem('inquiry-country'); if(savedCountry&&inquiryCountry) inquiryCountry.value=savedCountry;
const openInquiry=(card)=>{inquiryProduct={title:card?.dataset.productTitle||'',sku:card?.dataset.productSku||'',image:card?.dataset.productImage||card?.querySelector('img')?.getAttribute('src')||''}; const image=document.querySelector('#inquiry-image'); if(image){image.src=inquiryProduct.image;image.alt=inquiryProduct.title;} const heading=document.querySelector('#inquiry-title'); if(heading)heading.textContent=inquiryProduct.title; const sku=document.querySelector('#inquiry-sku'); if(sku)sku.textContent=inquiryProduct.sku?`SKU · ${inquiryProduct.sku}`:''; if(inquiryQty)inquiryQty.value='1'; const country=inquiryCountry?.value||'Your country'; if(inquiryMessage)inquiryMessage.value=`I'm from ${country}, I'm interested in this ${inquiryProduct.sku||inquiryProduct.title}, please send me quote on this`; if(inquiryModal)inquiryModal.hidden=false;};
document.addEventListener('click',event=>{const target=event.target;if(!(target instanceof Element))return;const button=target.closest('[data-inquiry-product]');if(button){event.preventDefault();event.stopPropagation();openInquiry(button.closest('.product-card'));}if(target.matches('[data-inquiry-close]')&&inquiryModal)inquiryModal.hidden=true;const qty=target.closest('[data-qty]');if(qty&&inquiryQty)inquiryQty.value=String(Math.min(999,Math.max(1,Number(inquiryQty.value||1)+Number(qty.getAttribute('data-qty')||0))));});
inquiryForm?.addEventListener('submit',event=>{event.preventDefault();const country=inquiryCountry?.value.trim()||'';if(country)localStorage.setItem('inquiry-country',country);const text=inquiryMessage?.value.trim()||'';window.open(`https://wa.me/85265426672?text=${encodeURIComponent(text)}`,'_blank','noopener');if(inquiryModal)inquiryModal.hidden=true;});
</script><script src="/review-upload.js" defer></script></body></html>
