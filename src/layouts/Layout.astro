---
const { title = 'Atelier Eleven', description = 'A considered collection of objects.' } = Astro.props;
import { ClientRouter } from 'astro:transitions';
import SiteHeader from '../components/SiteHeader.astro';
---
<!doctype html><html lang="en"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width" /><meta name="description" content={description} /><title>{title}</title><ClientRouter /></head><body><SiteHeader /><slot /><button class="basket-fab" type="button" data-basket-open aria-label="View basket" title="View basket"><img src="/cart.svg" alt="" /><span data-basket-count hidden>0</span></button><div class="basket-drawer" id="basket-drawer" hidden><div class="basket-backdrop" data-basket-close></div><aside class="basket-panel" role="dialog" aria-modal="true" aria-labelledby="basket-title"><div class="basket-header"><h2 id="basket-title">Basket</h2><button class="basket-close" type="button" data-basket-close aria-label="Close basket">×</button></div><p class="basket-empty" id="basket-empty">Your basket is empty.</p><div class="basket-items" id="basket-items"></div><div class="basket-footer"><button class="basket-inquiry basket-whatsapp" type="button" data-basket-inquiry="whatsapp"><img src="/whatsapp-mark.svg" alt="" />WhatsApp enquiry</button><button class="basket-inquiry basket-email" type="button" data-basket-inquiry="email"><img src="/email-mark.svg" alt="" />Email enquiry</button></div></aside></div><div class="inquiry-modal" id="inquiry-modal" hidden><div class="inquiry-backdrop" data-inquiry-close></div><section class="inquiry-dialog" role="dialog" aria-modal="true" aria-labelledby="inquiry-title"><button class="inquiry-close" type="button" aria-label="Close" data-inquiry-close>×</button><div class="inquiry-product"><img id="inquiry-image" src="" alt="" /><div><h2 id="inquiry-title"></h2><p id="inquiry-sku"></p></div></div><form id="inquiry-form" class="inquiry-form"><label>Quantity<div class="quantity-control"><button type="button" data-qty="-1" aria-label="Decrease quantity">−</button><input id="inquiry-quantity" name="quantity" type="number" min="1" max="999" value="1" /><button type="button" data-qty="1" aria-label="Increase quantity">+</button></div></label><label>Country<div class="country-combobox"><input id="inquiry-country" name="country" placeholder="Search country" required autocomplete="off" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="inquiry-countries" /><div id="inquiry-countries" class="country-options" role="listbox" hidden><button type="button" role="option">United States</button><button type="button" role="option">United Kingdom</button><button type="button" role="option">Canada</button><button type="button" role="option">Australia</button><button type="button" role="option">Germany</button><button type="button" role="option">France</button><button type="button" role="option">Italy</button><button type="button" role="option">Spain</button><button type="button" role="option">Singapore</button><button type="button" role="option">Malaysia</button><button type="button" role="option">Japan</button><button type="button" role="option">South Korea</button><button type="button" role="option">China</button><button type="button" role="option">Hong Kong</button><button type="button" role="option">Taiwan</button><button type="button" role="option">India</button><button type="button" role="option">Other</button></div></div></label><label>Message<textarea id="inquiry-message" name="message" rows="4" maxlength="1000" required></textarea><button class="inquiry-submit" id="inquiry-submit" type="submit">Send via WhatsApp</button></form></section></div><script>
  document.querySelectorAll<HTMLAnchorElement>('a[href^="https://wa.me/"], a[href^="mailto:"]').forEach((link) => { link.target = '_blank'; link.rel = 'noopener noreferrer'; });
</script><script is:inline>
const inquiryModal=document.querySelector('#inquiry-modal'); const inquiryForm=document.querySelector('#inquiry-form'); const inquiryCountry=document.querySelector('#inquiry-country'); const inquiryCountryOptions=document.querySelector('#inquiry-countries'); const inquiryMessage=document.querySelector('#inquiry-message'); const inquiryQty=document.querySelector('#inquiry-quantity'); const inquirySubmit=document.querySelector('#inquiry-submit'); let inquiryProduct={title:'',sku:'',image:'',channel:'whatsapp',variants:''};
document.querySelectorAll('.product-card').forEach(card=>{if(!card.dataset.productTitle)card.dataset.productTitle=card.querySelector('.product-copy strong')?.textContent?.trim()||'';if(!card.dataset.productImage)card.dataset.productImage=card.querySelector('img')?.getAttribute('src')||'';if(!card.dataset.productSku){const slug=card.getAttribute('href')?.match(/chanel-(\d+-\d+)/)?.[1];card.dataset.productSku=slug||card.dataset.productTitle||'';}const copy=card.querySelector('.product-copy');const paragraph=copy?.querySelector('p');if(copy&&paragraph&&!copy.querySelector('.description-wrap')){const wrap=document.createElement('div');wrap.className='description-wrap';paragraph.replaceWith(wrap);wrap.appendChild(paragraph);const more=document.createElement('button');more.type='button';more.className='description-toggle';more.dataset.descriptionToggle='';more.textContent='View more';wrap.appendChild(more);}if(!card.querySelector('[data-inquiry-product]')){const button=document.createElement('button');button.className='inquiry-card-button';button.type='button';button.dataset.inquiryProduct='';button.innerHTML='<img src="/whatsapp-mark.svg" alt="">WhatsApp inquiry';card.appendChild(button);}});
const savedCountry=localStorage.getItem('inquiry-country'); if(savedCountry&&inquiryCountry) inquiryCountry.value=savedCountry;
const closeCountryOptions=()=>{if(inquiryCountryOptions)inquiryCountryOptions.hidden=true;if(inquiryCountry)inquiryCountry.setAttribute('aria-expanded','false');}; const showCountryOptions=()=>{if(inquiryCountryOptions)inquiryCountryOptions.hidden=false;if(inquiryCountry)inquiryCountry.setAttribute('aria-expanded','true');}; const filterCountryOptions=()=>{const query=inquiryCountry?.value.trim().toLowerCase()||'';inquiryCountryOptions?.querySelectorAll('button').forEach(option=>{option.hidden=!(option.textContent?.toLowerCase().includes(query)||false);});}; const selectCountry=(country)=>{if(!inquiryCountry)return;inquiryCountry.value=country;inquiryCountry.dispatchEvent(new Event('input',{bubbles:true}));closeCountryOptions();};
const inquiryMessageText=()=>{const country=inquiryCountry?.value.trim()||'';const prefix=country?"I'm from "+country+', ':'';const variants=inquiryProduct.variants?' Selected variants: '+inquiryProduct.variants+'.':'';const subject=inquiryProduct.sku||inquiryProduct.title;return subject?prefix+'I\'m interested in this '+subject+', please send me quote on this.'+variants:prefix+'I would like to make an enquiry.';};
const openInquiry=(source)=>{const card=source?.closest('.product-card');const detail=source?.closest('[data-product-title]');const variants=Array.from(detail?.closest('main')?.querySelectorAll('.variant-group')||[]).map(group=>(group.getAttribute('data-variant-name')||'')+': '+(group.querySelector('.variant-option.selected')?.getAttribute('data-value')||'')).filter(Boolean).join('; ');inquiryProduct={title:source?.dataset.productTitle||card?.dataset.productTitle||detail?.dataset.productTitle||'',sku:source?.dataset.productSku||card?.dataset.productSku||detail?.dataset.productSku||'',image:source?.dataset.productImage||card?.dataset.productImage||detail?.dataset.productImage||card?.querySelector('img')?.getAttribute('src')||'',channel:source?.dataset.inquiryChannel||'whatsapp',variants:source?.dataset.productVariants||variants};const productPanel=document.querySelector('.inquiry-product');if(productPanel)productPanel.hidden=!inquiryProduct.title;const image=document.querySelector('#inquiry-image');if(image){image.src=inquiryProduct.image;image.alt=inquiryProduct.title;}const heading=document.querySelector('#inquiry-title');if(heading)heading.textContent=inquiryProduct.title||'General enquiry';const sku=document.querySelector('#inquiry-sku');if(sku)sku.textContent=inquiryProduct.sku?'SKU · '+inquiryProduct.sku:'';if(inquiryQty)inquiryQty.value='1';if(inquiryMessage)inquiryMessage.value=inquiryMessageText();if(inquirySubmit)inquirySubmit.textContent=inquiryProduct.channel==='email'?'Send via Email':'Send via WhatsApp';if(inquiryModal)inquiryModal.hidden=false;};
document.addEventListener('click',event=>{const target=event.target;if(!(target instanceof Element))return;const toggle=target.closest('[data-description-toggle]');if(toggle){event.preventDefault();event.stopPropagation();const wrap=toggle.closest('.description-wrap');wrap?.classList.toggle('is-expanded');toggle.textContent=wrap?.classList.contains('is-expanded')?'View less':'View more';return;}const countryOption=target.closest('#inquiry-countries button');if(countryOption){selectCountry(countryOption.textContent?.trim()||'');return;}const button=target.closest('[data-inquiry-product]');if(button){event.preventDefault();event.stopPropagation();openInquiry(button);}if(target.matches('[data-inquiry-close]')&&inquiryModal){inquiryModal.hidden=true;closeCountryOptions();}const qty=target.closest('[data-qty]');if(qty&&inquiryQty)inquiryQty.value=String(Math.min(999,Math.max(1,Number(inquiryQty.value||1)+Number(qty.getAttribute('data-qty')||0))));if(!target.closest('.country-combobox'))closeCountryOptions();});
inquiryCountry?.addEventListener('focus',()=>{filterCountryOptions();showCountryOptions();});inquiryCountry?.addEventListener('input',()=>{const country=inquiryCountry.value.trim();if(country)localStorage.setItem('inquiry-country',country);else localStorage.removeItem('inquiry-country');if(inquiryMessage)inquiryMessage.value=inquiryMessageText();filterCountryOptions();showCountryOptions();});inquiryCountry?.addEventListener('keydown',event=>{if(event.key==='Escape')closeCountryOptions();}); inquiryForm?.addEventListener('submit',event=>{event.preventDefault();const country=inquiryCountry?.value.trim()||'';if(country)localStorage.setItem('inquiry-country',country);else localStorage.removeItem('inquiry-country');const text=inquiryMessage?.value.trim()||'';if(inquiryProduct.channel==='email'){const subject=encodeURIComponent(inquiryProduct.title?'Quote request: '+inquiryProduct.title:'General enquiry');window.location.href='mailto:info@maesvanti.online?subject='+subject+'&body='+encodeURIComponent(text);}else window.open('https://wa.me/85265426672?text='+encodeURIComponent(text),'_blank','noopener');if(inquiryModal)inquiryModal.hidden=true;closeCountryOptions();});
</script><script is:inline>
document.querySelectorAll('.product-card').forEach(card=>{const sku=card.querySelector('[data-product-sku]')?.getAttribute('data-product-sku');if(sku)card.dataset.productSku=sku;});
</script><script src="/basket.js" defer></script><script src="/review-upload.js" defer></script></body></html>
