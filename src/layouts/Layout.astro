---
const { title = 'Atelier Eleven', description = 'A considered collection of objects.' } = Astro.props;
import SiteHeader from '../components/SiteHeader.astro';
---
<!doctype html><html lang="en"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width" /><meta name="description" content={description} /><title>{title}</title></head><body><SiteHeader /><slot /><script>
  document.querySelectorAll<HTMLAnchorElement>('a[href^="https://wa.me/"], a[href^="mailto:"]').forEach((link) => {
    link.target = '_blank';
    link.rel = 'noopener noreferrer';
  });
</script></body></html>
